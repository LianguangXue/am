<div class="toast" id="toast"></div>
<script>
const esc = v => String(v ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const cut = (v,n) => { const t = String(v ?? ''); return t.length > n ? t.slice(0,n-1) + '…' : t; };
const dur = m => m < 90 ? m + 'm' : (m < 2160 ? Math.floor(m/60) + 'h' : Math.floor(m/1440) + 'd' + Math.floor(m%1440/60) + 'h');
const chip = (c,t) => `<span class="chip ${c}">${esc(t)}</span>`;
const live = q => q <= 2 ? 'live' : (q <= 15 ? 'idle' : '');
const AGENTS = ['claude-code','codex','dsh'];

const S = { q:'', sel:null, showHidden:false, paused:false, data:null, sig:'', closed:new Set() };

function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('on');
  clearTimeout(toast._t); toast._t=setTimeout(()=>t.classList.remove('on'),1400); }
function copy(text){ if(navigator.clipboard) navigator.clipboard.writeText(text); toast('已复制 ' + text); }

function matches(r){
  if (!S.q) return true;
  const q = S.q.toLowerCase();
  return [r.short, r.agent, r.title, r.progress, r.intent, r.asked, r.action,
          (r.workflow||{}).name].some(v => String(v||'').toLowerCase().includes(q));
}

function ordered(){
  const visible = (S.data.sessions||[]).filter(matches);
  const by = {};
  visible.forEach(r => (by[r.agent] = by[r.agent]||[]).push(r));
  const main = (S.data.main||{}).short;
  const base = AGENTS.filter(a=>by[a]).concat(Object.keys(by).filter(a=>!AGENTS.includes(a)));
  const groups = base.map(agent => {
    const rows = by[agent].slice().sort((a,b) => (b.short===main)-(a.short===main) || a.quiet-b.quiet);
    return { agent, rows };
  });
  const hidden = S.showHidden ? (S.data.hidden||[]).filter(matches) : [];
  return { groups, hidden, flat: groups.flatMap(g=>g.rows.map(r=>r.short)).concat(hidden.map(r=>r.short)) };
}

function navRow(r, muted){
  const wf = r.workflow && r.workflow.name ? `wf ${r.workflow.reached}/${(r.workflow.phases||[]).length}` : '';
  const main = (S.data.main||{}).short === r.short;
  const name = r.title || r.progress || r.short;
  return `<button class="item ${S.sel===r.short?'on':''} ${muted?'muted':''} ${main?'main':''}"
      data-short="${esc(r.short)}"><span class="dot ${muted?'':live(r.quiet)}"></span>
      <span class="nm">${esc(cut(name, 26))}</span>
      <span class="q">${wf || (muted ? '隐藏' : dur(r.quiet))}</span></button>`;
}

function renderNav(){
  const { groups, hidden } = ordered();
  let html = `<button class="item ${S.sel===null?'on':''}" data-short="">
      <span class="nm" style="font-weight:600">概览</span>
      <span class="q">${(S.data.tasks||[]).filter(t=>['open','claimed','blocked'].includes(t.status)).length}</span></button>`;
  html += groups.map(g => {
    const closed = S.closed.has(g.agent);
    return `<div class="grp ${closed?'closed':''}" data-g="${esc(g.agent)}">${esc(g.agent)}
      <span class="n">${g.rows.length}</span><span class="chev">▾</span></div>
      <div style="${closed?'display:none':''}">${g.rows.map(r=>navRow(r,false)).join('')}</div>`;
  }).join('');
  if ((S.data.hidden||[]).length) {
    html += `<div class="grp" id="toggle-hidden">已隐藏<span class="n">${(S.data.hidden||[]).length}</span>
      <span style="margin-left:auto;font-weight:400;text-transform:none;letter-spacing:0">${S.showHidden?'收起':'展开'}</span></div>`;
    if (S.showHidden) html += hidden.length ? hidden.map(r=>navRow(r,true)).join('')
      : `<div class="nav-empty">没有匹配的隐藏会话</div>`;
  }
  if (!groups.length && !S.q) html += `<div class="nav-empty">最近 ${S.data.window_days||30} 天没有会话</div>`;
  if (!groups.length && S.q) html += `<div class="nav-empty">没有匹配「${esc(S.q)}」的会话</div>`;
  document.getElementById('nav').innerHTML = html;
}

function tile(n,label,cls){ return `<div class="tile ${cls||''}"><b>${n}</b><span>${esc(label)}</span></div>`; }

function renderSummary(){
  const tasks = (S.data.tasks||[]).filter(t=>['open','claimed','blocked'].includes(t.status));
  const wfs = (S.data.sessions||[]).filter(s=>s.workflow && s.workflow.name);
  const main = S.data.main;
  let h = `<h1>总体情况</h1><div class="sub">窗口 最近 ${S.data.window_days||30} 天 ·
    生成于 ${esc((S.data.generated||'').slice(11,19))} · 库 ${esc(S.data.store)}</div>`;
  h += `<div class="tiles">${tile(S.data.counts.active,'活跃会话','live')}
    ${tile(tasks.length,'在飞任务','acc')}${tile(S.data.counts.sessions,'最近 ' + (S.data.window_days||30) + ' 天会话')}
    ${tile(wfs.length,'工作流','warn')}</div>`;

  if (main) {
    h += `<div class="sec-t">当前主 agent</div><div class="row"><div class="m">
      <div><span class="id">${esc(main.agent)}</span><span class="ti">${esc(main.title||main.short)}</span></div>
      <div class="sub" style="margin-top:4px">${esc(main.progress || main.intent || '')}</div>
      <div class="nx">am brief --for ${esc(main.agent)}</div></div>
      <div>${chip('ok','quiet '+dur(main.quiet))}</div></div>`;
  }

  h += `<div class="sec-t">在飞任务</div>`;
  h += tasks.length ? tasks.map(t => {
    const known = (S.data.sessions||[]).some(s=>s.short===t.session) ? t.session : null;
    return `<div class="row"><div class="m">
      <div><span class="id">${esc(t.id)}</span><span class="ti">${esc(cut(t.title,64))}</span></div>
      <div class="sub" style="margin-top:4px">${esc(t.owner||'未认领')}${known
        ? ` / <span class="link" data-jump="${esc(known)}">${esc(known)}</span>`
        : (t.session ? ' / ' + esc(t.session.slice(0,13)) : '')}</div>
      ${t.next ? `<div class="nx">→ ${esc(t.next)}</div>` : ''}
    </div><div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
      ${chip(t.status==='blocked'?'bad':t.status==='claimed'?'acc':'ghost', t.status)}
      ${t.quiet!=null?chip(t.idle?'bad':'ok','quiet '+dur(t.quiet)):''}
    </div></div>`;
  }).join('') : `<div class="empty-box">没有在飞任务。</div>`;

  h += `<div class="sec-t">工作流</div>`;
  h += wfs.length ? wfs.map(s => { const w=s.workflow; return `<div class="row"><div class="m">
      <div><span class="id">${esc(w.name)}</span><span class="ti">${esc(s.title||s.short)} · ${esc(s.agent)}</span></div>
      <div class="sub" style="margin-top:4px">推进到 ${w.reached}/${(w.phases||[]).length}
        ${w.accepted?'· 通过 '+w.accepted.length:''}${w.rejected?'· 驳回 '+w.rejected.length:''}
        ${w.missing?'· 未完成 '+w.missing.length:''}</div></div>
      <div>${chip(w.status==='failed'?'bad':w.status==='completed'?'ok':'warn', w.status)}</div></div>`;
  }).join('') : `<div class="empty-box">没有工作流记录。</div>`;
  document.getElementById('pane').innerHTML = h;
}

function steps(w){
  const ph=w.phases||[], r=w.reached||0;
  return `<div class="steps">`+ph.map((p,i)=>{
    const c=i<r?'done':(i===r?(w.status==='failed'?'dead':'now'):'');
    return `<div class="step ${c}"><div class="n">${i+1}</div><div class="t">${esc(p)}</div></div>`;
  }).join('')+`</div>`;
}

function workflowBlock(w){
  if(!w||!w.name) return '';
  const row=(k,v)=>`<li><span class="k">${esc(k)}</span><span class="v">${esc(v)}</span></li>`;
  let h=`<div class="wf"><div class="wf-head"><span class="wf-name">${esc(w.name)}</span>
    ${chip(w.status==='failed'?'bad':w.status==='completed'?'ok':'warn',w.status)}
    <span class="chip ghost">${w.reached||0}/${(w.phases||[]).length} 阶段</span>
    <span class="chip ghost">idle ${dur(w.idle_min||0)}</span></div>`;
  h+=steps(w)+`<ul class="wf-list">`;
  if(w.accepted&&w.accepted.length) h+=row('已通过',w.accepted.join(' · '));
  if(w.rejected&&w.rejected.length) h+=row('被驳回',w.rejected.join(' · '));
  if(w.missing&&w.missing.length) h+=row('没跑完',w.missing.join(' · '));
  h+=`</ul>`;
  for(const [a,why] of Object.entries(w.rejects||{})) h+=`<div class="wf-why"><b>${esc(a)}</b> 被驳回：${esc(why)}</div>`;
  for(const p of (w.killed||[])) h+=`<div class="wf-why"><b>${esc(p[0])}</b> 中断：${esc(p[1])}</div>`;
  if(w.next_phase){ h+=`<div class="wf-next">下一步 <b>${esc(w.next_phase)}</b>`;
    if(w.next_criteria) h+=`<br><span style="color:#9fb6d4">${esc(w.next_criteria)}</span>`; h+=`</div>`; }
  if(w.resume&&w.resume.length){
    h+=`<ul class="wf-list" style="margin-top:10px">`+w.resume.map(r=>{const t=(r.trees||[{}])[0]||{};
      return `<li><span class="k">工件</span><span class="v">${esc(t.branch||'')} @ ${esc(t.head||'')}
        ${esc((t.path||'').replace(/^.*wf6\//,'…/wf6/'))}</span></li>`;}).join('')+`</ul>`;
  }
  return h+`</div>`;
}

function renderDetail(short){
  const s=(S.data.sessions||[]).concat(S.data.hidden||[]).find(r=>r.short===short);
  if(!s){ S.sel=null; return renderSummary(); }
  const hidden=(S.data.hidden||[]).some(r=>r.short===short);
  const main=(S.data.main||{}).short===short;
  let h=`<h1>${esc(s.title||s.short)}</h1>
    <div class="sub"><span class="chip ghost">${esc(s.agent)}</span><code>${esc(s.short)}</code>
      ${chip(s.quiet<=2?'ok':'warn','quiet '+dur(s.quiet))}
      ${main?chip('acc','主 agent'):''}${hidden?chip('bad','已隐藏'):''}</div>
    <div class="acts">
      <button class="btn ghost" data-copy="am adopt ${esc(s.short)}"><code>am adopt ${esc(s.short)}</code></button>
      <button class="btn ghost" data-copy="am brief --for ${esc(s.agent)}"><code>am brief --for ${esc(s.agent)}</code></button>
      <button class="btn" data-hide="${esc(s.short)}" data-undo="${hidden?1:0}">${hidden?'恢复显示':'隐藏这个会话'}</button>
    </div>`;
  h+=`<dl class="kv"><dt>开始于</dt><dd class="clamp" title="${esc(s.intent||'')}">${esc(s.intent||'—')}</dd>
    ${s.asked?`<dt>最近提问</dt><dd>${esc(s.asked)}</dd>`:''}
    <dt>推进到</dt><dd>${esc(s.progress||'—')}</dd>
    ${s.action?`<dt>最后动作</dt><dd class="cmd" title="${esc(s.action)}">${esc(s.action)}</dd>`:''}</dl>`;
  h+=workflowBlock(s.workflow);
  document.getElementById('pane').innerHTML=h;
}

function renderPane(){
  const pane=document.getElementById('pane'), top=pane.scrollTop;
  if(S.sel) renderDetail(S.sel); else renderSummary();
  pane.scrollTop=top;
}

function select(short){ S.sel=short||null; renderNav(); renderPane(); }

async function toggleHide(short, undo){
  await fetch('/api/hide',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({short, undo, why:'ui'})});
  if(!undo && S.sel===short) S.sel=null;
  toast(undo?'已恢复':'已隐藏'); await tick(true);
}

async function tick(force){
  if (S.paused && !force) return;
  try{
    const d=await (await fetch('/api/state',{cache:'no-store'})).json();
    document.getElementById('stamp').textContent=(d.generated||'').slice(11,19);
    const sig=JSON.stringify([d.tasks,d.sessions,d.hidden,d.active,d.main&&d.main.short,d.counts]);
    if(!force && sig===S.sig) return;
    S.sig=sig; S.data=d;
    if(S.sel && ![...(d.sessions||[]),...(d.hidden||[])].some(r=>r.short===S.sel)) S.sel=null;
    document.getElementById('stats').innerHTML=
      `<span>活跃 <b>${d.counts.active}</b></span><span>任务 <b>${d.counts.tasks_open}</b></span>
       <span>会话 <b>${d.counts.sessions}</b></span>`;
    renderNav(); renderPane();
  }catch(e){ document.getElementById('stamp').textContent='离线'; }
}

document.addEventListener('click', e => {
  // Destructive actions only honour a real user gesture. Synthetic clicks from
  // automation were hiding sessions during testing.
  const trusted = e.isTrusted !== false;
  const jump=e.target.closest('[data-jump]'); if(jump){ select(jump.dataset.jump); return; }
  const cp=e.target.closest('[data-copy]'); if(cp){ copy(cp.dataset.copy); return; }
  const hd=e.target.closest('[data-hide]');
  if(hd){ if(!trusted) return; toggleHide(hd.dataset.hide, hd.dataset.undo==='1'); return; }
  const it=e.target.closest('.item'); if(it){ select(it.dataset.short||null); return; }
  if(e.target.closest('#toggle-hidden')){ S.showHidden=!S.showHidden; renderNav(); return; }
  const g=e.target.closest('.grp[data-g]');
  if(g){ const k=g.dataset.g; if(S.closed.has(k)) S.closed.delete(k); else S.closed.add(k); renderNav(); }
});

document.addEventListener('keydown', e => {
  const typing = e.target.tagName === 'INPUT';
  if (e.key === '/' && !typing) { e.preventDefault(); document.getElementById('q').focus(); return; }
  if (e.key === 'Escape') { if (typing) { e.target.value=''; S.q=''; renderNav(); e.target.blur(); }
                            else select(null); return; }
  if (typing) return;
  if (e.key === 'p') { S.paused=!S.paused;
    const b=document.getElementById('pause'); b.classList.toggle('on', S.paused);
    b.textContent = S.paused ? '已暂停' : '暂停';
    if (!S.paused) tick(true); return; }
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    e.preventDefault();
    const flat = ordered().flat;
    const idx = flat.indexOf(S.sel);
    const next = e.key === 'ArrowDown'
      ? (idx < 0 ? 0 : Math.min(flat.length-1, idx+1))
      : (idx <= 0 ? null : idx-1);
    select(next === null ? null : flat[next]);
  }
});

document.getElementById('q').addEventListener('input', ev => { S.q = ev.target.value.trim(); renderNav(); });
document.getElementById('pause').addEventListener('click', () => {
  S.paused = !S.paused;
  const b = document.getElementById('pause');
  b.classList.toggle('on', S.paused);
  b.textContent = S.paused ? '已暂停' : '暂停';
  if (!S.paused) tick(true);
});

tick(); setInterval(tick, 2500);
</script></body></html>"""


def dashboard_html(cfg: dict) -> str:
  """Return the single-page dashboard with the project name substituted."""
  return DASHBOARD_HTML.replace("__PROJECT__", str(cfg.get("project") or "am"))


def cmd_serve(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Serve the dashboard and its JSON endpoint."""
  from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

  page = dashboard_html(cfg).encode("utf-8")
  state_lock = threading.Lock()

  class Handler(BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802 - stdlib naming
      if self.path.startswith("/api/state"):
        with state_lock:
          body = json.dumps(state_payload(am, cfg), ensure_ascii=False).encode("utf-8")
        kind = "application/json; charset=utf-8"
      elif self.path in ("/", "/index.html"):
        body, kind = page, "text/html; charset=utf-8"
      else:
        self.send_error(404)
        return
      self.send_response(200)
      self.send_header("Content-Type", kind)
      self.send_header("Content-Length", str(len(body)))
      self.send_header("Cache-Control", "no-store")
      self.end_headers()
      self.wfile.write(body)

    def do_POST(self):  # noqa: N802 - stdlib naming
      if not self.path.startswith("/api/hide"):
        self.send_error(404)
        return
      try:
        length = int(self.headers.get("Content-Length") or 0)
        body = json.loads(self.rfile.read(length) or b"{}")
      except (ValueError, json.JSONDecodeError):
        self.send_error(400)
        return
      short = str(body.get("short") or "").strip()
      if not short:
        self.send_error(400)
        return
      hide_session(am, short, str(body.get("why") or "manual"), state=not body.get("undo"))
      out = json.dumps({"ok": True, "hidden": sorted(hidden_state(am))}).encode("utf-8")
      self.send_response(200)
      self.send_header("Content-Type", "application/json; charset=utf-8")
      self.send_header("Content-Length", str(len(out)))
      self.end_headers()
      self.wfile.write(out)

    def log_message(self, *args):  # keep the terminal quiet
      return

  server = ThreadingHTTPServer((args.host, args.port), Handler)
  url = f"http://{args.host if args.host != '0.0.0.0' else '127.0.0.1'}:{args.port}/"
  print(f"am dashboard → {url}")
  print(f"store: {am}")
  print("ctrl-c to stop", file=sys.stderr)
  try:
    server.serve_forever()
  except KeyboardInterrupt:
    print("", file=sys.stderr)
  finally:
    server.server_close()
  return 0


# ---------------------------------------------------------- semantic (optional)


def embedder_python() -> str:
  """Return the interpreter that hosts the optional embedding dependencies."""
  candidates = []
  override = os.environ.get("AM_EMBED_PYTHON")
  if override:
    candidates.append(override)
  candidates.append(str(Path.home() / ".am-embed" / "venv" / "bin" / "python"))
  candidates.append(sys.executable)
  for candidate in candidates:
    if Path(candidate).is_file():
      return candidate
  return sys.executable


def embedder_script(am: Path) -> Path:
  """Return the path of ``am-embed.py`` next to this CLI."""
  return Path(__file__).resolve().parent / "am-embed.py"


def index_dir(am: Path) -> Path:
  """Return the semantic index directory."""
  return am / "idx"


def collect_chunks(am: Path, days: float, all_scopes: bool, max_sessions: int,
                   chunk_chars: int = 600, min_chars: int = 24, limit_total: int = 40000) -> list[dict]:
  """Extract embeddable text spans from the transcripts in scope."""
  cutoff = now().timestamp() - days * 86400.0
  slug = scope_slug(am.parent)
  chunks: list[dict] = []

  for agent, base, pattern in transcript_sources():
    if not base.is_dir():
      continue
    candidates: list[tuple[float, Path]] = []
    for path in base.glob(pattern):
      if not all_scopes and not session_in_scope(agent, path, am.parent, slug):
        continue
      try:
        mtime = path.stat().st_mtime
      except OSError:
        continue
      if mtime < cutoff:
        continue
      candidates.append((mtime, path))
    candidates.sort(reverse=True)

    for _, path in candidates[:max_sessions]:
      lines = read_zstd_lines(path) if path.suffix == ".zstd" else _read_lines(path)
      session = path.parent.name if path.suffix == ".zstd" else path.stem
      for number, line in enumerate(lines):
        try:
          record = json.loads(line)
        except json.JSONDecodeError:
          continue
        if not isinstance(record, dict):
          continue
        text = " ".join(record_text(agent, record).split())
        if len(text) < min_chars:
          continue
        chunks.append({
          "id": f"{path}#{number}",
          "ts": normalize_time(record.get("timestamp") or record.get("time")),
          "agent": agent,
          "session": session,
          "path": str(path),
          "text": text[:chunk_chars],
        })
        if len(chunks) >= limit_total:
          return chunks
  return chunks


def cmd_embed(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Build or refresh the semantic index."""
  chunks = collect_chunks(am, args.days, args.all, args.max_sessions, args.chunk_chars)
  if not chunks:
    die("no embeddable text found in scope; widen with --days or --all")
  directory = index_dir(am)
  directory.mkdir(parents=True, exist_ok=True)
  chunk_file = directory / "chunks.jsonl"
  with chunk_file.open("w", encoding="utf-8") as handle:
    for chunk in chunks:
      handle.write(json.dumps(chunk, ensure_ascii=False, sort_keys=True) + "\n")

  script = embedder_script(am)
  interpreter = embedder_python()
  print(f"embedding {len(chunks)} chunks via {interpreter}", file=sys.stderr)
  done = subprocess.run(
    [interpreter, str(script), "--model", args.model, "index", "--idx", str(directory),
     "--chunks", str(chunk_file), "--batch", str(args.batch)],
    capture_output=True, text=True, check=False,
  )
  if done.returncode != 0:
    print(done.stderr.strip(), file=sys.stderr)
    die("embedding failed; see the message above")
  meta = load_json(directory / "meta.json", {})
  meta["window_days"] = args.days
  meta["chunk_chars"] = args.chunk_chars
  save_json(directory / "meta.json", meta)
  print(f"index ready: {meta.get('count', '?')} vectors × {meta.get('dim', '?')} dims "
        f"({meta.get('model', '?')}) in {directory}")
  if done.stderr.strip():
    print(done.stderr.strip().splitlines()[-1], file=sys.stderr)
  return 0


def semantic_query(am: Path, text: str, limit: int) -> list[dict]:
  """Ask the optional embedder for the nearest chunks, or explain why not."""
  directory = index_dir(am)
  meta_path = directory / "meta.json"
  if not meta_path.is_file():
    print(T("rc.no_index"), file=sys.stderr)
    return []
  script = embedder_script(am)
  interpreter = embedder_python()
  try:
    done = subprocess.run(
      [interpreter, str(script), "query", "--idx", str(directory), "--text", text, "--limit", str(limit)],
      capture_output=True, text=True, timeout=180, check=False,
    )
  except (OSError, subprocess.SubprocessError) as exc:
    print(T("rc.failed", r=exc), file=sys.stderr)
    return []
  if done.returncode != 0:
    lines = [line.strip() for line in done.stderr.splitlines() if line.strip()]
    reason = lines[0] if lines else f"exit {done.returncode}"
    print(f"# semantic query unavailable ({reason}); falling back to literal search", file=sys.stderr)
    return []
  try:
    rows = json.loads(done.stdout or "[]")
  except json.JSONDecodeError:
    print(T("rc.garbage"), file=sys.stderr)
    return []
  return [row for row in rows if isinstance(row, dict)]


# ------------------------------------------------------------------- rendering


def seconds_between(start: str, end: str) -> float:
  """Return seconds from ``start`` to ``end``, or 0 when either is unparseable."""
  try:
    return (datetime.fromisoformat(end) - datetime.fromisoformat(start)).total_seconds()
  except (TypeError, ValueError):
    return 0.0


def last_event(events: list[dict], *types: str, task: str | None = None) -> dict | None:
  """Return the newest event matching any of ``types`` (and optionally a task)."""
  for event in reversed(events):
    if types and event.get("type") not in types:
      continue
    if task is not None and event.get("task") != task:
      continue
    return event
  return None


def task_table(am: Path, tasks: list[dict]) -> list[str]:
  """Render the task table used by ``status`` and ``state.md``."""
  if not tasks:
    return [T("st.none")]
  lines = [T("tt.header"), "|---|---|---|---|---|"]
  for item in tasks:
    lease = read_lease(am, item["id"])
    if lease and lease.get("live"):
      tag = str(lease.get("session") or "")[:8]
      quiet = lease.get("last_seen_min")
      flag = ""
      if quiet is not None:
        flag = f" quiet{quiet}m" + ("!" if lease.get("idle") else "")
      lease_cell = f"{lease.get('agent', '?')}" + (f":{tag}" if tag else "") + f" {lease.get('remaining_min', 0)}m{flag}"
    elif item.get("status") in {"done", "cancelled"}:
      lease_cell = "-"
    else:
      lease_cell = "free"
    step = (item.get("next") or "").replace("|", "\\|").replace("\n", " ")
    if len(step) > 60:
      step = step[:57] + "..."
    lines.append(f"| `{item['id']}` | {item.get('status', '?')} | {item.get('owner') or '-'} | {lease_cell} | {step or '-'} |")
  return lines


def render_state(am: Path, cfg: dict) -> str:
  """Compile ``state.md`` from the journal and the task records."""
  events = load_events(am)
  tasks = load_tasks(am)
  goal = last_event(events, "goal")
  blockers = [item for item in tasks if item.get("status") == "blocked"]

  out = [T("st.title", project=cfg["project"]), ""]
  out.append(T("st.compiled", ts=iso(now()), n=len(events)))
  out.append(T("st.regen"))
  out.append("")
  out.append(T("st.h_goal"))
  out.append("")
  out.append(goal["summary"] if goal else T("st.no_goal"))
  out.append("")
  out.append(T("st.h_tasks"))
  out.append("")
  out.extend(task_table(am, tasks))
  out.append("")
  if blockers:
    out.append(T("st.h_blockers"))
    out.append("")
    for item in blockers:
      out.append(f"- `{item['id']}` — {item.get('blocked_reason') or T('st.reason_missing')}")
    out.append("")
  out.append(T("st.h_recent"))
  out.append("")
  if not events:
    out.append(T("b.none"))
  for event in events[-15:]:
    refs = f" ({', '.join(event['refs'])})" if event.get("refs") else ""
    task = f" [{event['task']}]" if event.get("task") else ""
    out.append(f"- `{event['ts'][:19]}` **{event['agent']}** {event['type']}{task}: {event.get('summary', '')}{refs}")
  out.append("")
  return "\n".join(out)


def render_overview(am: Path, cfg: dict, agent: str, tasks: list[dict]) -> str:
  """One screen listing every in-flight task, so the caller can choose one.

  This exists because a single agent usually has several sessions in flight at
  once (one per feature family, one migration, one investigation). Picking for
  the successor would be a guess; showing every candidate with its owner, its
  session, and how long that session has been quiet makes the choice one glance.
  """
  events = load_events(am)
  latest: dict[str, dict] = {}
  for event in events:
    if event.get("task"):
      latest[event["task"]] = event

  ranked = sorted(tasks, key=lambda item: latest.get(item["id"], {}).get("ts", ""), reverse=True)
  out = [T("o.title", project=cfg["project"]), ""]
  out.append(T("o.for", agent=agent, ts=iso(now()), n=len(ranked)))
  out.append("")
  out.append(T("pre.pick"))
  out.append("")
  out.append(T("o.header"))
  out.append("|---|---|---|---|---|---|")
  for item in ranked:
    lease = read_lease(am, item["id"]) or {}
    session = str(lease.get("session") or "-")[:13]
    quiet = lease.get("last_seen_min")
    quiet_cell = "?" if quiet is None else (f"**{quiet}m**" if lease.get("idle") else f"{quiet}m")
    stamp = latest.get(item["id"], {}).get("ts", "")
    action = clip(str(latest.get(item["id"], {}).get("summary", "-")), 52)
    out.append(f"| `{item['id']}` | {item.get('status')} | {lease.get('agent') or item.get('owner') or '-'} "
               f"| {session} | {quiet_cell} | {action} |")
  out.append("")
  out.append(T("o.quiet_note"))
  out.append("")
  return "\n".join(out)


def write_state(am: Path, cfg: dict) -> Path:
  """Rewrite ``state.md`` and return its path."""
  path = am / "state.md"
  path.write_text(render_state(am, cfg), encoding="utf-8")
  return path


def render_brief(am: Path, cfg: dict, agent: str, budget_tokens: int, events: list[dict],
                 target_id: str | None = None, caller_id: str = "") -> str:
  """Render the five-block resume brief handed to ``agent``."""
  tasks = load_tasks(am)
  goal = last_event(events, "goal")
  target = get_task(am, target_id, required=False) if target_id else select_target(am, agent)
  char_budget = max(1200, budget_tokens * 4)

  out = [T("b.title", project=cfg["project"]), ""]
  out.append(T("b.for", agent=agent, ts=iso(now()), n=len(events)))
  out.append("")
  out.append(T("pre.data"))
  out.append("")

  out.append(T("b.h1"))
  out.append("")
  out.append(goal["summary"] if goal else T("b.no_goal"))
  out.append("")

  out.append(T("b.h2"))
  out.append("")
  if target is None:
    out.append(T("b.no_task"))
  else:
    lease = read_lease(am, target["id"])
    out.append(T("b.id", id=target["id"], title=target.get("title", "")))
    out.append(T("b.status", status=target.get("status"), owner=target.get("owner") or T("b.unclaimed")))
    if lease and lease.get("live"):
      holder = lease.get("agent")
      session = str(lease.get("session") or "")
      quiet = lease.get("last_seen_min")
      seen = ""
      if quiet is not None:
        seen = T("b.seen_dead" if lease.get("idle") else "b.seen", m=quiet)
      out.append(T("b.lease", agent=holder, session=(f" / `{session[:13]}`" if session else ""),
                   minutes=lease.get("remaining_min"), seen=seen))
      # `caller_id` is who is rendering; without it this branch crashed whenever
      # the reader was also the lease holder, because it reached for `args`.
      if holder != agent or (session and session != caller_id):
        out.append(T("b.steal", id=target["id"]))
    else:
      out.append(T("b.lease_free", id=target["id"]))
    if target.get("status") == "blocked":
      out.append(T("b.blocked", reason=target.get("blocked_reason") or T("b.no_reason")))
    accept = (target.get("accept") or "").strip()
    out.append(T("b.done_when", text=accept if accept else T("b.done_missing")))
    if target.get("spec"):
      out.append("")
      out.append("```")
      out.append(str(target["spec"]).strip()[:600])
      out.append("```")
  out.append("")

  out.append(T("b.h3"))
  out.append("")
  recent = [event for event in events if event.get("type") != "cmd"][-8:]
  if not recent:
    out.append(T("b.none"))
  for event in recent:
    refs = f" ({', '.join(event['refs'])})" if event.get("refs") else ""
    task = f" [{event['task']}]" if event.get("task") else ""
    line = f"- `{event['ts'][:16].replace('T', ' ')}` {event['agent']}/{event['type']}{task}: {event.get('summary', '')}{refs}"
    if event.get("evidence"):
      line += T("b.evidence", text=event["evidence"])
    out.append(line)
  out.append("")

  observed = load_tail(am, limit=14)
  if observed:
    last_curated = str(events[-1].get("ts", "")) if events else ""
    newest = str(observed[-1].get("ts", ""))
    # Cry wolf only when the unrecorded activity is somebody else's, or when the
    # gap is too large to be the reader's own commands racing the journal write.
    # Compare against whoever is *executing* now, not against `--for`: a human
    # asking for codex's brief from inside a dsh session is still dsh's own noise.
    foreign = observed[-1].get("agent") != detect_agent()
    if newest > last_curated and (foreign or seconds_between(last_curated, newest) > 120):
      out.append(T("b.died", newest=newest[11:19], last=(last_curated[11:19] or "never")))
      out.append("")
    out.append(T("b.observed"))
    out.append("")
    for item, repeats in collapse_observations(observed)[-6:]:
      text = str(item.get("text", "")).replace("\n", " ").strip()
      if len(text) > 160:
        text = text[:157] + "..."
      suffix = f" ×{repeats}" if repeats > 1 else ""
      out.append(f"- `{str(item.get('ts', ''))[11:19]}` {item.get('agent')} {item.get('kind')}{suffix}: `{text}`")
    out.append("")

  out.append(T("b.h4"))
  out.append("")
  step = None
  if target is not None:
    step = last_event(events, "next", task=target["id"])
    step = step or (target.get("next") and {"summary": target["next"]}) or None
  if step:
    out.append("```bash")
    out.append(str(step.get("summary", "")).strip())
    out.append("```")
  elif observed:
    # Nobody declared a next step. The transcript still knows the last command,
    # which is usually enough to resume — and demanding a declaration is exactly
    # the friction that makes the store feel like a chore.
    last = observed[-1]
    out.append(T("b.next_observed", ts=str(last.get("ts", ""))[11:19], agent=last.get("agent")))
    out.append("")
    out.append("```bash")
    out.append(str(last.get("text", "")).strip())
    out.append("```")
    out.append("")
    out.append(T("b.next_observed_hint"))
  else:
    out.append(T("b.no_next"))
  out.append("")

  out.append(T("b.h5"))
  out.append("")
  blockers = [item for item in tasks if item.get("status") == "blocked"]
  if blockers:
    for item in blockers:
      out.append(T("b.blocked_item", id=item["id"], reason=item.get("blocked_reason") or T("b.no_reason")))
  else:
    out.append("- " + T("b.no_blockers"))
  decisions = [event for event in events if event.get("type") == "decision"][-3:]
  if decisions:
    out.append("")
    out.append(T("b.decisions"))
    for event in decisions:
      out.append(f"- {event.get('summary', '')} (by {event['agent']}, {event['ts'][:10]})")
  out.append("")

  text = "\n".join(out)
  if len(text) > char_budget:
    keep = char_budget - 400
    text = text[:keep] + "\n\n" + T("b.truncated") + "\n"
  return text


# -------------------------------------------------------------------- commands


def bundled_doc(name: str) -> str:
  """Return a doc shipped beside the script, if this is a repo install."""
  here = Path(__file__).resolve()
  for base in (here.parent.parent / "docs", here.parent, Path.home() / ".local/share/am/docs"):
    candidate = base / name
    try:
      if candidate.is_file():
        return candidate.read_text(encoding="utf-8")
    except OSError:
      continue
  return ""


def cmd_init(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Create the store tree, config, and ignore rules."""
  for sub in ("journal", "tasks", "leases", "briefs"):
    (am / sub).mkdir(parents=True, exist_ok=True)
  save_json(am / "config.json", cfg)
  write_state(am, cfg)
  print(f"initialised {am}")
  doc = bundled_doc("DESIGN.md")
  if doc:
    (am / "DESIGN.md").write_text(doc, encoding="utf-8")
  if args.link:
    (Path.home() / ".am-root").write_text(str(am.resolve()) + "\n", encoding="utf-8")
  print(T("c.init_next", v=am))
  return 0


def cmd_goal(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Record the project goal."""
  event = base_event(args, "goal", args.text)
  append_event(am, event)
  write_state(am, cfg)
  print(T("c.goal", v=args.text))
  return 0


def cmd_task(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Create or update a task record."""
  if args.action == "add":
    if not args.accept:
      die(T("e.needs_accept"))
    existing = get_task(am, args.id, required=False)
    record = existing or {"id": slug(args.id), "created": iso(now()), "status": "open", "owner": None}
    record.update({"title": args.title or record.get("title", ""), "accept": args.accept, "spec": args.spec or record.get("spec", "")})
    if record.get("status") in {None, ""}:
      record["status"] = "open"
    save_task(am, record)
    append_event(am, base_event(args, "task", f"task `{record['id']}`: {record.get('title', '')}", task=record["id"]))
    write_state(am, cfg)
    print(f"task {record['id']} saved ({record['status']})")
    return 0
  if args.action == "list":
    items = load_tasks(am)
    if not getattr(args, "all", False):
      items = [item for item in items if item.get("status") not in ("done", "cancelled")]
    print("\n".join(task_table(am, items)))
    return 0
  die(f"unknown task action '{args.action}'")
  return 2


def cmd_log(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Append a free-form typed event."""
  if args.type not in EVENT_TYPES:
    die(T("e.unknown_type", v=args.type, known=", ".join(EVENT_TYPES)))
  event = base_event(args, args.type, args.summary, task=args.task or current_task_id(am, args))
  if args.evidence:
    event["evidence"] = args.evidence
  if args.commit:
    event["commit"] = args.commit
  append_event(am, event)
  write_state(am, cfg)
  print(f"logged {args.type} → {event['task'] or '(no task)'}")
  return 0


def current_task_id(am: Path, args: argparse.Namespace) -> str | None:
  """Return ``--task`` or the agent's active task id."""
  if getattr(args, "task", None):
    return slug(args.task)
  active = active_task(am, args.agent)
  return active["id"] if active else None


def cmd_next(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Record the exact next command for the task, so handoff is mechanical."""
  task_id = args.task or current_task_id(am, args)
  if not task_id:
    die(T("e.needs_next_task"))
  record = get_task(am, task_id)
  assert record is not None
  record["next"] = args.command
  save_task(am, record)
  event = base_event(args, "next", args.command, task=task_id)
  append_event(am, event)
  write_state(am, cfg)
  print(T("c.next", id=task_id))
  return 0


def cmd_claim(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Take a TTL lease on a task so two live agents cannot fight over it."""
  record = get_task(am, args.id)
  assert record is not None
  return claim_record(am, cfg, args, record)


def claim_record(am: Path, cfg: dict, args: argparse.Namespace, record: dict) -> int:
  """Lease an existing task record to the calling session."""
  if record.get("status") == "done":
    die(T("e.already_done", id=record["id"]))
  session = caller_session(args)
  lease = read_lease(am, record["id"])
  mine = bool(lease) and lease.get("agent") == args.agent
  if mine and lease.get("session") and session["id"]:
    mine = lease["session"] == session["id"]
  if lease and lease.get("live") and not mine and not args.force:
    holder = lease.get("session") or "(unknown session)"
    idle = lease.get("last_seen_min")
    seen = T("b.seen", m=idle) if idle is not None else ""
    die(T("e.lease_held", id=record["id"], agent=lease.get("agent"),
          session=holder, seen=seen, m=lease.get("remaining_min")))
  minutes = args.ttl or cfg["lease_minutes"]
  expires = now() + timedelta(minutes=minutes)
  save_json(lease_path(am, record["id"]), {
    "agent": args.agent,
    "session": session["id"],
    "session_path": session["path"],
    "session_source": session["source"],
    "expires": iso(expires),
  })
  record["status"] = "claimed" if record.get("status") in {"open", "blocked"} else record.get("status")
  record["owner"] = args.agent
  save_task(am, record)
  append_event(am, base_event(args, "claim", f"claimed for {minutes}m", task=record["id"]))
  write_state(am, cfg)
  print(T("c.claimed", id=record["id"], agent=args.agent, m=minutes))
  return 0


def cmd_start(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Bind this session to a task, creating the task when it does not exist yet.

  This is the missing verb: ``task add`` created work nobody could attach to,
  and ``claim`` required an id to already exist. ``start`` is one step for both,
  so a session that is about to do something declares it on the way in.
  """
  task_id = slug(args.id)
  if not task_id or task_id == "unknown":
    die(T("e.bad_task_id", v=args.id))
  record = get_task(am, task_id, required=False)
  if record is None:
    record = {
      "id": task_id, "created": iso(now()), "status": "open", "owner": None,
      "title": args.title or task_id, "accept": args.accept or "", "spec": args.spec or "",
    }
    save_task(am, record)
    append_event(am, base_event(args, "task", f"task `{task_id}`: {record['title']}", task=task_id))
    print(T("c.started_new", id=task_id, title=record["title"]))
  else:
    if record.get("status") == "done":
      die(T("e.already_done", id=task_id))
    print(T("c.started_existing", id=task_id))
  return claim_record(am, cfg, args, record)


def cmd_release(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Drop a lease without finishing the task."""
  record = get_task(am, args.id)
  assert record is not None
  lease = read_lease(am, record["id"])
  if lease and lease.get("agent") != args.agent and not args.force:
    die(f"lease on '{record['id']}' belongs to {lease.get('agent')}, not {args.agent}")
  lease_path(am, record["id"]).unlink(missing_ok=True)
  record["status"] = "open" if record.get("status") == "claimed" else record.get("status")
  record["owner"] = None
  save_task(am, record)
  append_event(am, base_event(args, "claim", "released", task=record["id"]))
  write_state(am, cfg)
  print(T("c.released", id=record["id"]))
  return 0


def cmd_done(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Close a task and require evidence."""
  record = get_task(am, args.id)
  assert record is not None
  if not args.evidence:
    die(T("e.needs_evidence"))
  record["status"] = "done"
  record["evidence"] = args.evidence
  record["commit"] = args.commit or record.get("commit", "")
  save_task(am, record)
  lease_path(am, record["id"]).unlink(missing_ok=True)
  event = base_event(args, "done", f"done: {args.evidence}", task=record["id"])
  if args.commit:
    event["commit"] = args.commit
  append_event(am, event)
  write_state(am, cfg)
  print(T("c.done", id=record["id"]))
  return 0


def cmd_block(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Mark a task blocked with the concrete reason."""
  record = get_task(am, args.id)
  assert record is not None
  record["status"] = "blocked"
  record["blocked_reason"] = args.reason
  save_task(am, record)
  lease_path(am, record["id"]).unlink(missing_ok=True)
  append_event(am, base_event(args, "blocker", args.reason, task=record["id"]))
  write_state(am, cfg)
  print(T("c.blocked", id=record["id"]))
  return 0


def cmd_brief(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Print the resume brief, or an overview when several tasks are in flight."""
  agent = slug(args.for_) if args.for_ else detect_agent()
  if not args.no_scan:
    watch_scan(am)
  inflight = [item for item in load_tasks(am) if item.get("status") in {"open", "claimed", "blocked"}]
  if args.task:
    target_id = slug(args.task)
  elif not inflight:
    # Nothing registered. Rather than a dead end, show what the agents are
    # actually doing — that is the question the caller is really asking.
    print("\n".join(render_sessions(recent_sessions(am, 7.0, 8))))
    return 0
  elif len(inflight) > 1:
    text = render_overview(am, cfg, agent, inflight)
    print(text)
    print("\n".join(render_sessions(recent_sessions(am, 7.0, 3))))
    return 0
  else:
    target_id = inflight[0]["id"]
  text = render_brief(am, cfg, agent, args.budget or cfg["brief_tokens"], load_events(am),
                      target_id, caller_session(args)["id"])
  text += "\n" + "\n".join(render_sessions(recent_sessions(am, 7.0, 3)))
  if args.save:
    path = am / "briefs" / f"{now().strftime('%Y%m%dT%H%M%S')}-{agent}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    print(f"# saved {path}", file=sys.stderr)
  print(text)
  return 0


def cmd_watch(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Ingest transcript activity, once or continuously."""
  if args.interval and args.interval > 0:
    print(f"watching every {args.interval}s (ctrl-c to stop)", file=sys.stderr)
    try:
      while True:
        added = watch_scan(am, days=args.days, max_sessions=args.max_sessions, all_scopes=args.all)
        if added:
          print(f"{iso(now())}  +{added} observations", file=sys.stderr)
        time.sleep(args.interval)
    except KeyboardInterrupt:
      return 0
  added = watch_scan(am, days=args.days, max_sessions=args.max_sessions, all_scopes=args.all)
  state = load_watch_state(am)
  print(f"scanned {len(state.get('files') or {})} transcript file(s), +{added} observation(s)")
  tail = load_tail(am, limit=5)
  for item in tail:
    text = str(item.get("text", "")).replace("\n", " ")[:100]
    print(f"  {str(item.get('ts', ''))[11:19]}  {item.get('agent')}  {text}")
  return 0


def cmd_status(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Print a short human summary."""
  if not getattr(args, "no_scan", False):
    watch_scan(am)
  events = load_events(am)
  tasks = load_tasks(am)
  goal = last_event(events, "goal")
  print(T("s.project", v=cfg["project"]))
  print(T("s.store", v=am))
  print(T("s.counts", e=len(events), t=len(tasks)))
  print(T("s.goal", v=goal["summary"] if goal else T("s.none")))
  print()
  print("\n".join(task_table(am, tasks)))
  tail = load_tail(am, limit=3)
  if tail:
    print()
    print(T("s.last"))
    for item in tail:
      text = str(item.get("text", "")).replace("\n", " ")[:100]
      print(f"  {str(item.get('ts', ''))[11:19]}  {item.get('agent')}  {text}")
  return 0


RESUME_BINARIES = {
  "claude-code": "claude", "claude": "claude",
  "codex": "codex",
  "dsh": "dsh", "deepseek": "dsh",
}


def resume_prompt(agent: str) -> str:
  """Return the first message that makes a fresh session pick up the handoff."""
  return T("r.prompt", agent=agent)


def cmd_resume(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Launch an agent with the handoff prompt already filled in."""
  raw = slug(args.agent_name)
  agent = {"claude": "claude-code", "deepseek": "dsh"}.get(raw, raw)
  binary = RESUME_BINARIES.get(agent) or RESUME_BINARIES.get(raw)
  if not binary:
    die(T("e.unknown_agent", v=args.agent_name, known=", ".join(sorted(RESUME_BINARIES))))
  prompt = resume_prompt(agent)
  command = [binary, prompt]
  if args.prompt_only:
    print(prompt)
    return 0
  if not args.exec_:
    print(f"# cd {am.parent}")
    print("# " + " ".join(shlex.quote(part) for part in command))
    print("# paste into Cursor's agent panel:  am resume " + agent + " --prompt-only")
    return 0
  path = shutil.which(binary)
  if not path:
    die(f"'{binary}' is not on PATH")
  print(f"# launching {binary} in {am.parent}", file=sys.stderr)
  os.chdir(am.parent)
  os.execv(path, command)
  return 0  # unreachable


def append_gz(path: Path, lines: list[str]) -> None:
  """Append lines to a gzip file as a new member.

  gzip allows concatenated members, so appending keeps earlier archives readable
  with a plain ``gzip.open(...).read()`` while never rewriting the whole file.
  """
  path.parent.mkdir(parents=True, exist_ok=True)
  with path.open("ab") as raw:
    with gzip.GzipFile(fileobj=raw, mode="wb", mtime=0) as handle:
      for line in lines:
        handle.write((line + "\n").encode("utf-8"))


def human_size(size: int) -> str:
  """Render a byte count the way a person reads it."""
  value = float(size)
  for unit in ("B", "KB", "MB", "GB"):
    if value < 1024 or unit == "GB":
      return f"{value:.0f}{unit}" if unit in ("B", "KB") else f"{value:.1f}{unit}"
    value /= 1024
  return f"{value:.1f}GB"


def store_usage(am: Path) -> list[tuple[str, int]]:
  """Return per-directory byte counts, largest first."""
  rows = []
  for entry in sorted(am.iterdir()):
    if not entry.is_dir():
      continue
    total = 0
    for item in entry.rglob("*"):
      try:
        if item.is_file():
          total += item.stat().st_size
      except OSError:
        continue
    if total:
      rows.append((entry.name, total))
  rows.sort(key=lambda row: row[1], reverse=True)
  return rows


def cmd_prune(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Archive settled work so the store stays readable as it ages.

  The rule this follows: **never delete what cannot be rebuilt.** Transcripts
  belong to the agents and are never touched. Within the store only two things
  are irreplaceable — the journal and finished task records — and both are
  *archived* (gzip, month-partitioned, one JSON object per line) rather than
  dropped. Everything else (`idx`, `tail`, `briefs`) is bounded or rebuildable.
  """
  days = args.days or int(cfg.get("retention_days") or 90)
  cutoff = now() - timedelta(days=days)
  archive = am / "archive"

  tasks: list[tuple[Path, dict, str]] = []
  journals: list[Path] = []
  briefs: list[Path] = []

  for path in sorted((am / "tasks").glob("*.json")):
    record = load_json(path, {})
    if not isinstance(record, dict) or record.get("status") != "done":
      continue
    stamp = str(record.get("updated") or record.get("created") or "")
    try:
      settled = datetime.fromisoformat(stamp)
    except ValueError:
      continue
    if settled < cutoff:
      tasks.append((path, record, stamp[:7] or "unknown"))

  for path in sorted((am / "briefs").glob("*.md")):
    try:
      if datetime.fromtimestamp(path.stat().st_mtime).astimezone() < cutoff:
        briefs.append(path)
    except OSError:
      continue

  empty_sessions: list[dict] = []
  if args.sessions:
    for row in recent_sessions(am, max(days, 7), 300):
      if not any([row.get("title"), row.get("intent"), row.get("progress"), row.get("action")]):
        empty_sessions.append(row)

  for path in sorted((am / "journal").glob("*.jsonl")):
    match = re.search(r"(\d{4})(\d{2})(\d{2})", path.stem)
    if not match:
      continue
    try:
      day = datetime(int(match.group(1)), int(match.group(2)), int(match.group(3))).astimezone()
    except ValueError:
      continue
    if day < cutoff:
      journals.append(path)

  usage = store_usage(am)
  if usage:
    print(T("p.usage"))
    for name, size in usage[:6]:
      print(f"  {name:<12} {human_size(size):>8}")
    print("")

  total = len(tasks) + len(journals) + len(briefs) + len(empty_sessions)
  print(T("p.head", days=days, n=total))
  if not total:
    print(T("p.nothing"))
    return 0
  for path, record, month in tasks:
    print("  " + T("p.item", label=f"task {record.get('id')} (done {month})"))
  for path in journals:
    print("  " + T("p.item", label=f"journal {path.name}"))
  for path in briefs:
    print("  " + T("p.item", label=f"brief {path.name}"))
  for row in empty_sessions:
    print("  " + T("p.item", label=T("p.empty_session", id=row["short"], agent=row["agent"],
                                        quiet=row["quiet"])))

  if not args.yes:
    print("\n" + T("p.dry"))
    return 0

  for path, record, month in tasks:
    append_gz(archive / "tasks" / f"tasks-{month}.jsonl.gz",
              [json.dumps(record, ensure_ascii=False, sort_keys=True)])
    path.unlink(missing_ok=True)
  for path in journals:
    append_gz(archive / "journal" / f"{path.stem}.jsonl.gz",
              [line for line in path.read_text(encoding="utf-8").splitlines() if line.strip()])
    path.unlink(missing_ok=True)
  for row in empty_sessions:
    hide_session(am, row["short"], "empty")
  for path in briefs:
    target = archive / "briefs" / path.name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(path.read_text(encoding="utf-8"), encoding="utf-8")
    path.unlink(missing_ok=True)

  write_state(am, cfg)
  print("\n" + T("p.done", n=total, at=archive))
  return 0


def cmd_where(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Print the store directory and project name."""
  print(am)
  return 0


def cmd_compile(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Regenerate ``state.md``."""
  print(T("c.state", v=write_state(am, cfg)))
  return 0


def cmd_doctor(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Check that the store is consistent enough for another agent to take over."""
  problems: list[str] = []
  warnings: list[str] = []
  tasks = load_tasks(am)
  events = load_events(am)

  if not events:
    warnings.append("journal is empty")
  if last_event(events, "goal") is None:
    # A brand-new store has nothing to be inconsistent with; that is a setup
    # step, not a fault.
    (warnings if not events else problems).append(
        T("d.no_goal") if events else T("d.new_store"))

  for item in tasks:
    if item.get("status") in {"done", "cancelled"}:
      continue
    if not item.get("accept"):
      problems.append(f"task `{item['id']}` has no acceptance criterion")
    if item.get("status") == "blocked" and not item.get("blocked_reason"):
      problems.append(f"task `{item['id']}` is blocked without a reason")
    lease = read_lease(am, item["id"])
    if lease and not lease.get("live"):
      warnings.append(f"task `{item['id']}` has an expired lease from {lease.get('agent')}")

  root = am.parent
  stamp = "am:entry"
  for name in ("AGENTS.md", "CLAUDE.md"):
    path = root / name
    if not path.is_file():
      warnings.append(f"{name} missing at {root} — that agent has no entry point")
      continue
    try:
      body = path.read_text(encoding="utf-8")
    except OSError as exc:
      warnings.append(f"cannot read {name}: {exc}")
      continue
    if stamp not in body:
      warnings.append(f"{name} lacks the `{stamp}` stanza")

  brief = render_brief(am, cfg, "doctor", cfg["brief_tokens"], events)
  if len(brief) > cfg["brief_tokens"] * 5:
    warnings.append(f"brief is ~{len(brief) // 4} tokens, above the {cfg['brief_tokens']} budget")

  for line in problems:
    print(T("d.err", v=line))
  for line in warnings:
    print(T("d.warn", v=line))
  if not problems and not warnings:
    print(T("d.ok"))
  else:
    print("\n" + T("d.summary", e=len(problems), w=len(warnings)))
  return 1 if problems else 0


def cmd_handoff(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Emit a brief for the successor agent, and the command to resume."""
  target = slug(args.to)
  if not getattr(args, "no_scan", False):
    watch_scan(am)
  text = render_brief(am, cfg, target, args.budget or cfg["brief_tokens"], load_events(am),
                      None, caller_session(args)["id"])
  path = am / "briefs" / f"{now().strftime('%Y%m%dT%H%M%S')}-{target}.md"
  path.parent.mkdir(parents=True, exist_ok=True)
  path.write_text(text, encoding="utf-8")
  print(text)
  print(file=sys.stderr)
  print(f"# handed off to {target} → {path}", file=sys.stderr)
  for item in load_tasks(am):
    if item.get("status") in {"open", "claimed"}:
      lease = read_lease(am, item["id"])
      if lease and lease.get("agent") != target:
        print(f"# warning: `{item['id']}` is leased to {lease.get('agent')}; "
              f"{target} must `am claim {item['id']} --force`", file=sys.stderr)
  return 0


def caller_session(args: argparse.Namespace) -> dict:
  """Resolve the calling session, honouring an explicit ``--session``."""
  explicit = getattr(args, "session", None)
  if explicit:
    agent = slug(getattr(args, "agent", None) or detect_agent())
    return {"id": explicit, "path": find_session_path(agent, explicit), "source": "flag"}
  agent = slug(getattr(args, "agent", None) or detect_agent())
  return current_session(agent)


def base_event(args: argparse.Namespace, event_type: str, summary: str, task: str | None = None) -> dict:
  """Build the common event envelope."""
  event = {
    "ts": iso(now()),
    "agent": slug(getattr(args, "agent", None) or detect_agent()),
    "type": event_type,
    "summary": summary,
    "task": task or getattr(args, "task", None),
    "refs": list(getattr(args, "ref", None) or []),
  }
  session_id = caller_session(args)["id"]
  if session_id:
    event["session"] = session_id
  model = getattr(args, "model", None)
  if model:
    event["model"] = model
  return event


# -------------------------------------------------------------------------- cli


def build_parser() -> argparse.ArgumentParser:
  """Assemble the argument parser."""
  parser = argparse.ArgumentParser(prog="am", description="cross-agent memory: journal, state, brief")
  parser.add_argument("--version", action="version", version=f"am {VERSION}")
  parser.add_argument("--root", help="path to the .agents store (default: search upward)")
  parser.add_argument("--agent", help="override the detected agent name")
  parser.add_argument("--model", help="model identifier recorded on events")
  parser.add_argument("--session", help="override the detected session id")
  parser.add_argument("--lang", choices=("en", "zh"), help="output language (default: $AM_LANG or $LANG)")
  sub = parser.add_subparsers(dest="command", required=True)

  p = sub.add_parser("init", help="create the store tree")
  p.add_argument("--project", help="project name shown in state and briefs")
  p.add_argument("--link", action="store_true",
                 help="also write ~/.am-root so `am` works from any directory")
  p.set_defaults(func=cmd_init)

  p = sub.add_parser("goal", help="record the project objective")
  p.add_argument("text")
  p.set_defaults(func=cmd_goal)

  p = sub.add_parser("task", help="create or list tasks")
  p.add_argument("action", choices=("add", "list"))
  p.add_argument("id", nargs="?")
  p.add_argument("--title")
  p.add_argument("--spec", help="free-form requirements")
  p.add_argument("--accept", help="how we know it is done; required to add")
  p.add_argument("--all", action="store_true", help="list finished tasks too")
  p.set_defaults(func=cmd_task)

  p = sub.add_parser("log", help="append a typed event")
  p.add_argument("type", choices=EVENT_TYPES)
  p.add_argument("summary")
  p.add_argument("--task")
  p.add_argument("--ref", action="append", metavar="PATH:LINE")
  p.add_argument("--evidence")
  p.add_argument("--commit")
  p.set_defaults(func=cmd_log)

  p = sub.add_parser("next", help="record the exact next command for a task")
  p.add_argument("command")
  p.add_argument("--task")
  p.set_defaults(func=cmd_next)

  p = sub.add_parser("sessions", help="list recent agent sessions and what they are about")
  p.add_argument("--days", type=float, default=7.0, metavar="N")
  p.add_argument("--limit", type=int, default=8, metavar="N")
  p.set_defaults(func=cmd_sessions)

  p = sub.add_parser("adopt", help="turn a discovered session into a task and take it over")
  p.add_argument("session", metavar="SESSION", help="session id prefix (from `am sessions`)")
  p.add_argument("--id", help="task id to create (default: derived from the session id)")
  p.add_argument("--title")
  p.add_argument("--accept")
  p.add_argument("--days", type=float, default=7.0, metavar="N")
  p.add_argument("--ttl", type=int)
  p.add_argument("--force", action="store_true")
  p.set_defaults(func=cmd_adopt)

  p = sub.add_parser("start", help="bind this session to a task, creating it if needed")
  p.add_argument("id", metavar="ID")
  p.add_argument("--title")
  p.add_argument("--accept", help="how we know it is done; required when creating")
  p.add_argument("--spec")
  p.add_argument("--ttl", type=int, help="lease minutes")
  p.add_argument("--force", action="store_true")
  p.set_defaults(func=cmd_start)

  p = sub.add_parser("claim", help="take a TTL lease on a task")
  p.add_argument("id")
  p.add_argument("--ttl", type=int, help="lease minutes")
  p.add_argument("--force", action="store_true", help="steal an expired or dead lease")
  p.set_defaults(func=cmd_claim)

  p = sub.add_parser("release", help="drop a lease without finishing")
  p.add_argument("id")
  p.add_argument("--force", action="store_true")
  p.set_defaults(func=cmd_release)

  p = sub.add_parser("done", help="close a task; evidence required")
  p.add_argument("id")
  p.add_argument("--evidence", required=True)
  p.add_argument("--commit")
  p.set_defaults(func=cmd_done)

  p = sub.add_parser("block", help="mark a task blocked with a reason")
  p.add_argument("id")
  p.add_argument("--reason", required=True)
  p.set_defaults(func=cmd_block)

  p = sub.add_parser("brief", help="print the resume brief")
  p.add_argument("--for", dest="for_", metavar="AGENT")
  p.add_argument("--task", metavar="ID", help="force the detailed brief for one task")
  p.add_argument("--budget", type=int, metavar="TOKENS")
  p.add_argument("--save", action="store_true")
  p.add_argument("--no-scan", action="store_true", help="skip the transcript scan")
  p.set_defaults(func=cmd_brief)

  p = sub.add_parser("handoff", help="produce a brief for the successor agent")
  p.add_argument("--to", required=True, metavar="AGENT")
  p.add_argument("--budget", type=int, metavar="TOKENS")
  p.add_argument("--no-scan", action="store_true")
  p.set_defaults(func=cmd_handoff)

  p = sub.add_parser("watch", help="ingest transcript activity (once, or every --interval)")
  p.add_argument("--once", action="store_true", help="single pass (default)")
  p.add_argument("--interval", type=int, default=0, metavar="SECONDS", help="loop forever")
  p.add_argument("--days", type=float, default=3.0, metavar="N", help="only files touched in the last N days")
  p.add_argument("--max-sessions", type=int, default=24, metavar="N", help="newest N files per agent")
  p.add_argument("--all", action="store_true", help="include sessions from other working directories")
  p.set_defaults(func=cmd_watch)

  p = sub.add_parser("status", help="short human summary")
  p.add_argument("--no-scan", action="store_true")
  p.set_defaults(func=cmd_status)

  p = sub.add_parser("recall", help="search transcript history (all agents)")
  p.add_argument("query", help="terms, space separated, all must appear")
  p.add_argument("--days", type=float, default=30.0, metavar="N")
  p.add_argument("--limit", type=int, default=20, metavar="N")
  p.add_argument("--max-sessions", type=int, default=60, metavar="N")
  p.add_argument("--agent", dest="agent_filter", metavar="NAME",
                 help="only claude-code / codex / dsh (default: all three)")
  p.add_argument("--all", action="store_true", help="include other working directories")
  p.add_argument("--smart", action="store_true",
                 help="add the semantic index (needs `am embed` and the optional venv)")
  p.add_argument("--min-score", type=float, default=0.50, metavar="S",
                 help="drop semantic hits below this cosine (default 0.50)")
  p.set_defaults(func=cmd_recall)

  p = sub.add_parser("embed", help="build the optional semantic index")
  p.add_argument("--days", type=float, default=30.0, metavar="N")
  p.add_argument("--max-sessions", type=int, default=60, metavar="N")
  p.add_argument("--batch", type=int, default=64)
  p.add_argument("--chunk-chars", type=int, default=600)
  p.add_argument("--all", action="store_true")
  p.add_argument("--model", default=os.environ.get("AM_EMBED_MODEL", "BAAI/bge-small-zh-v1.5"))
  p.set_defaults(func=cmd_embed)

  p = sub.add_parser("resume", help="launch an agent with the handoff prompt")
  p.add_argument("agent_name", metavar="AGENT", help="claude-code / codex / dsh")
  p.add_argument("--exec", dest="exec_", action="store_true", help="actually launch it")
  p.add_argument("--prompt-only", action="store_true", help="print just the opening message")
  p.set_defaults(func=cmd_resume)

  p = sub.add_parser("serve", help="serve the live dashboard in a browser")
  p.add_argument("--port", type=int, default=37778)
  p.add_argument("--host", default="127.0.0.1", help="0.0.0.0 to expose on the LAN")
  p.set_defaults(func=cmd_serve)

  p = sub.add_parser("prune", help="archive settled tasks, old briefs and journals")
  p.add_argument("--days", type=int, help="retention window (default: config retention_days, 90)")
  p.add_argument("--yes", action="store_true", help="actually archive; without it this is a dry run")
  p.add_argument("--sessions", action="store_true",
                 help="also hide sessions that carry no title, intent, progress or command")
  p.set_defaults(func=cmd_prune)

  p = sub.add_parser("hide", help="hide or restore sessions in every listing")
  p.add_argument("session", nargs="+", metavar="ID", help="short session id (from `am sessions`)")
  p.add_argument("--reason", help="why it is being hidden")
  p.add_argument("--undo", action="store_true", help="restore instead of hiding")
  p.set_defaults(func=cmd_hide)

  p = sub.add_parser("where", help="print the store directory")
  p.set_defaults(func=cmd_where)

  p = sub.add_parser("compile", help="regenerate state.md from the journal")
  p.set_defaults(func=cmd_compile)

  p = sub.add_parser("doctor", help="check the store is handoff-ready")
  p.set_defaults(func=cmd_doctor)

  return parser


def main(argv: list[str] | None = None) -> int:
  """Entry point."""
  args = build_parser().parse_args(argv)
  set_lang(getattr(args, "lang", None))
  if args.command == "init":
    if not args.root:
      am = Path.cwd() / ".agents"
    else:
      am = Path(args.root).expanduser().resolve()
      am = am if am.name == ".agents" else am / ".agents"
    am.mkdir(parents=True, exist_ok=True)
    cfg = load_config(am)
    if getattr(args, "project", None):
      cfg["project"] = args.project
    return cmd_init(am, cfg, args)
  am = resolve_am(args.root)
  cfg = load_config(am)
  args.agent = slug(args.agent) if args.agent else detect_agent()
  return args.func(am, cfg, args)


if __name__ == "__main__":
  raise SystemExit(main())
