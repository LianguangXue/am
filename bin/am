LEASE_DEFAULT_MIN = 45
BRIEF_DEFAULT_TOKENS = 800
TAIL_KEEP = 400
TAIL_ROTATE_AT = 600
DSH_CMD_TOOLS = {"bash", "pwsh", "terminal", "bash_persistent", "pwsh_persistent", "shell"}
DSH_FILE_TOOLS = {"write", "edit", "str_replace_editor", "apply_patch"}
CLAUDE_FILE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
CODEX_EXEC_RE = re.compile(r"tools\.exec_command\(")


