  # -- resume ---------------------------------------------------------------
  "r.prompt": {
    "en": ("First run `am brief --for {agent}`. If more than one task is in flight, paste that table back to me "
           "verbatim and wait for me to say which one to continue — do not pick for me. If there is exactly one, "
           "continue from section 2. If the lease belongs to a session that is dead or out of quota (quiet in bold), "
           "run `am claim <id> --force` first. Before you touch anything, tell me in one sentence what you are "
           "about to do."),
    "zh": ("先运行 `am brief --for {agent}`。如果有多个任务在飞，把那张表原样贴给我，等我指定继续哪个，不要自己挑；"
           "如果只有一个任务，就按第 2 段继续；如果租约属于一个已死或没额度的会话（静默加粗），"
           "先 `am claim <id> --force` 再动手。动手前把你要做的第一件事用一句话告诉我。"),
  },
}


def set_lang(value: str | None) -> None:
  """Select the output language: explicit flag, then $AM_LANG, then the locale."""
  global LANG
  candidate = (value or os.environ.get("AM_LANG") or os.environ.get("LANG")
               or os.environ.get("LC_ALL") or "en").lower()
  LANG = "zh" if candidate.startswith("zh") else "en"


def T(message: str, **fields: object) -> str:
  """Look up one message in the active language.

  The first parameter is deliberately *not* called ``key``: callers pass message
  fields by name, and a field named ``key`` would collide with it.
  """
  entry = MSG.get(message)
  if not entry:
    return message
  text = entry.get(LANG) or entry["en"]
  return text.format(**fields) if fields else text


def die(msg: str, code: int = 2) -> None:
  """Print an error to stderr and exit."""
  print(f"am: {msg}", file=sys.stderr)
  raise SystemExit(code)


def now() -> datetime:
  """Return the current timezone-aware local time."""
  return datetime.now().astimezone()


def iso(dt: datetime) -> str:
  """Format a datetime as second-precision ISO 8601 with offset."""
  return dt.isoformat(timespec="seconds")


def detect_agent() -> str:
  """Infer which agent is running from the process environment."""
  override = os.environ.get("AM_AGENT")
  if override:
    return slug(override)
  if os.environ.get("DSH_SESSION_ID"):
    return "dsh"
  if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_ENTRYPOINT"):
    return "claude-code"
  if any(key.startswith("CODEX_") for key in os.environ):
    return "codex"
  return "unknown"


def slug(text: str) -> str:
  """Reduce text to a filesystem-safe token."""
  return re.sub(r"[^a-z0-9_.-]+", "-", text.strip().lower()).strip("-") or "unknown"


def resolve_am(explicit: str | None) -> Path:
  """Locate the ``.agents`` store from an argument, ``$AM_ROOT``, or the cwd upward."""
  candidates: list[Path] = []
  if explicit:
    candidates.append(Path(explicit).expanduser())
  if os.environ.get("AM_ROOT"):
    candidates.append(Path(os.environ["AM_ROOT"]).expanduser())
  if candidates:
    for cand in candidates:
      cand = cand if cand.name == ".agents" else cand / ".agents"
      if (cand / "config.json").is_file():
        return cand.resolve()
    die(T("e.bad_store", v=candidates[0]))
  here = Path.cwd().resolve()
  for directory in (here, *here.parents):
    store = directory / ".agents"
    if (store / "config.json").is_file():
      # Resolve symlinks: `~/.agents` points at the real store inside a working
      # tree, and every path derived from `am.parent` (project scope, relative
      # links) must not depend on which door the caller came in through.
      return store.resolve()
  # Last resort: a pointer file at ~/.am-root, so a caller whose cwd is outside
  # any tree containing .agents/ can still find the store. It is a *file*, not a
  # symlink, because a symlink breaks Codex's bubblewrap sandbox outright:
  #   cannot enforce sandbox read-only path ~/.agents because it crosses
  #   writable symlink
  pointer = Path.home() / ".am-root"
  if pointer.is_file():
    try:
      target = pointer.read_text(encoding="utf-8").strip()
    except OSError:
      target = ""
    if target:
      store = Path(target).expanduser()
      if (store / "config.json").is_file():
        return store.resolve()
  die(T("e.no_store", v=here))
  raise AssertionError("unreachable")


def load_json(path: Path, default: object) -> object:
  """Read a JSON file, returning ``default`` when absent or unreadable."""
  try:
    with path.open(encoding="utf-8") as handle:
      return json.load(handle)
  except FileNotFoundError:
    return default
  except json.JSONDecodeError as exc:
    die(f"corrupt JSON in {path}: {exc}")


def save_json(path: Path, payload: object) -> None:
  """Atomically write JSON so a crash cannot leave a half-written file."""
  path.parent.mkdir(parents=True, exist_ok=True)
  tmp = path.with_suffix(path.suffix + ".tmp")
  with tmp.open("w", encoding="utf-8") as handle:
    json.dump(payload, handle, ensure_ascii=False, indent=2, sort_keys=True)
    handle.write("\n")
  os.replace(tmp, path)


def load_config(am: Path) -> dict:
  """Return the store configuration, filling in defaults."""
  cfg = load_json(am / "config.json", {})
  assert isinstance(cfg, dict)
  cfg.setdefault("project", am.parent.name)
  cfg.setdefault("lease_minutes", LEASE_DEFAULT_MIN)
  cfg.setdefault("brief_tokens", BRIEF_DEFAULT_TOKENS)
  return cfg


# ---------------------------------------------------------------------- journal


def append_event(am: Path, event: dict) -> Path:
  """Append one event to this agent's journal file for the day."""
  day = event["ts"][:10]
  path = am / "journal" / f"{slug(event['agent'])}-{day}.jsonl"
  path.parent.mkdir(parents=True, exist_ok=True)
  with path.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
  return path


def load_events(am: Path) -> list[dict]:
  """Read every journal file, skipping lines that fail to parse mid-write."""
  events: list[dict] = []
  for path in sorted((am / "journal").glob("*.jsonl")):
    with path.open(encoding="utf-8") as handle:
      for raw in handle:
        raw = raw.strip()
        if not raw:
          continue
        try:
          events.append(json.loads(raw))
        except json.JSONDecodeError:
          continue
  events.sort(key=lambda item: item.get("ts", ""))
  return events


# ------------------------------------------------------------------------ tasks


def task_path(am: Path, task_id: str) -> Path:
  """Return the record path for one task."""
  return am / "tasks" / f"{slug(task_id)}.json"


def load_tasks(am: Path) -> list[dict]:
  """Return every task record, sorted by id."""
  tasks = []
  for path in sorted((am / "tasks").glob("*.json")):
    record = load_json(path, None)
    if isinstance(record, dict):
      tasks.append(record)
  tasks.sort(key=lambda item: item.get("id", ""))
  return tasks


def get_task(am: Path, task_id: str, required: bool = True) -> dict | None:
  """Load one task or fail with a helpful message."""
  record = load_json(task_path(am, task_id), None)
  if not isinstance(record, dict):
    if required:
      known = ", ".join(item["id"] for item in load_tasks(am)) or "(none)"
      die(T("e.unknown_task", id=task_id, known=known))
    return None
  return record


def save_task(am: Path, record: dict) -> None:
  """Persist a task record."""
  record["updated"] = iso(now())
  save_json(task_path(am, record["id"]), record)


def lease_path(am: Path, task_id: str) -> Path:
  """Return the lease path for one task."""
  return am / "leases" / f"{slug(task_id)}.json"


SESSION_INFER_WINDOW_S = 180


def transcript_mtime(path_text: str) -> float:
  """Return the mtime of a transcript path, or 0 when unreadable."""
  if not path_text:
    return 0.0
  try:
    return Path(path_text).stat().st_mtime
  except OSError:
    return 0.0


def find_session_path(agent: str, session: str) -> str:
  """Return the transcript file belonging to ``session`` for ``agent``."""
  if not session:
    return ""
  for name, base, pattern in transcript_sources():
    if name != agent or not base.is_dir():
      continue
    for path in base.glob(pattern):
      stem = path.parent.name if path.suffix == ".zstd" else path.stem
      if stem == session:
        return str(path)
  return ""


def current_session(agent: str) -> dict:
  """Best-effort identity of the session that is calling right now.

  DSH puts its session id in the environment. Claude Code and Codex do not, so
  the caller's own transcript file is the signal: the session running this
  command wrote that file seconds ago, so the newest file for the agent inside a
  short window is almost always it. With several sessions of the same agent
  alive at once this can pick the wrong one, which is why every command that
  records a session also accepts an explicit ``--session``.
  """
  env = os.environ.get("DSH_SESSION_ID")
  if env:
    return {"id": env, "path": find_session_path(agent, env), "source": "env"}
  newest, newest_path = 0.0, None
  for name, base, pattern in transcript_sources():
    if name != agent or not base.is_dir():
      continue
    for path in base.glob(pattern):
      try:
        mtime = path.stat().st_mtime
      except OSError:
        continue
      if mtime > newest:
        newest, newest_path = mtime, path
  if newest_path is not None and (now().timestamp() - newest) <= SESSION_INFER_WINDOW_S:
    stem = newest_path.parent.name if newest_path.suffix == ".zstd" else newest_path.stem
    return {"id": stem, "path": str(newest_path), "source": "inferred"}
  return {"id": "", "path": "", "source": "none"}


def read_lease(am: Path, task_id: str) -> dict | None:
  """Return a lease if it exists, annotated with liveness."""
  lease = load_json(lease_path(am, task_id), None)
  if not isinstance(lease, dict):
    return None
  try:
    expires = datetime.fromisoformat(lease["expires"])
  except (KeyError, ValueError):
    lease["live"] = False
    return lease
  lease["live"] = expires > now()
  lease["remaining_min"] = max(0, int((expires - now()).total_seconds() // 60))
  # Liveness comes from the owning *session's* transcript, not from "the agent is
  # running somewhere". With five Claude sessions in parallel that distinction is
  # the whole point: one live floor does not mean every task is still moving.
  stamp = transcript_mtime(str(lease.get("session_path") or ""))
  lease["last_seen_min"] = None if not stamp else max(0, int((now().timestamp() - stamp) // 60))
  lease["idle"] = lease["last_seen_min"] is not None and lease["last_seen_min"] > 15
  return lease


def active_task(am: Path, agent: str) -> dict | None:
  """Return the most recently claimed, still-open task owned by ``agent``."""
  owned = [item for item in load_tasks(am) if item.get("status") in {"open", "claimed", "blocked"}]
  owned = [item for item in owned if item.get("owner") == agent]
  if not owned:
    return None
  owned.sort(key=lambda item: item.get("updated", ""), reverse=True)
  return owned[0]


def select_target(am: Path, agent: str) -> dict | None:
  """Pick the task a resuming agent should look at, never hiding a claimed one.

  A task leased to another agent is still the most relevant thing to report: the
  successor has to see it and be told to steal the lease when that agent is dead.
  Returning "nothing to do" because a lease is live is the worst possible failure
  mode for a handoff store, so live leases never remove a task from view.
  """
  tasks = load_tasks(am)
  live = {"open", "claimed", "blocked"}

  for item in tasks:
    if item.get("status") in live and item.get("owner") == agent:
      return item
  for item in tasks:
    if item.get("status") != "claimed":
      continue
    lease = read_lease(am, item["id"])
    if lease and lease.get("live"):
      return item
  for status in ("open", "claimed", "blocked"):
    for item in tasks:
      if item.get("status") == status:
        return item
  return None


# ---------------------------------------------------------------- transcripts
#
# Capture is deliberately independent of the agents: all three already persist
# JSONL transcripts, so tailing them needs no hook, no plugin and no cooperation
# from the dying process. This is the part that keeps the store honest when an
# agent is killed mid-turn without writing a single `am` command.


def transcript_sources() -> list[tuple[str, Path, str]]:
  """Return ``(agent, root, glob)`` for every supported transcript store."""
  home = Path.home()
  claude = Path(os.environ.get("CLAUDE_CONFIG_DIR") or home / ".claude").expanduser()
  codex = Path(os.environ.get("CODEX_HOME") or home / ".codex").expanduser()
  dsh = Path(os.environ.get("DSH_HOME") or home / ".dsh").expanduser()
  return [
    ("claude-code", claude / "projects", "**/*.jsonl"),
    ("codex", codex / "sessions", "**/rollout-*.jsonl"),
    ("dsh", dsh / "sessions", "**/session*.jsonl.zstd"),
  ]


def normalize_time(value: object) -> str:
  """Convert an ISO string or epoch-millisecond number to a local ISO timestamp."""
  if isinstance(value, (int, float)):
    return datetime.fromtimestamp(float(value) / 1000.0).astimezone().isoformat(timespec="seconds")
  if isinstance(value, str) and value:
    try:
      return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone().isoformat(timespec="seconds")
    except ValueError:
      return value
  return iso(now())


def read_tail_lines(path: Path, offset: int) -> tuple[list[str], int]:
  """Read complete lines after ``offset`` and return them with the new offset.

  A partially written trailing line is left unread rather than parsed, so a scan
  racing a live writer can never corrupt the tail.
  """
  try:
    size = path.stat().st_size
  except OSError:
    return [], offset
  if size <= offset:
    return [], size
  try:
    with path.open("rb") as handle:
      handle.seek(offset)
      blob = handle.read()
  except OSError:
    return [], offset
  end = blob.rfind(b"\n")
  if end < 0:
    return [], offset
  chunk = blob[:end + 1]
  return chunk.decode("utf-8", "replace").splitlines(), offset + len(chunk)


def read_zstd_lines(path: Path) -> list[str]:
  """Decompress a zstd-compressed JSONL session log via the ``zstd`` binary."""
  exe = shutil.which("zstd")
  if not exe:
    return []
  try:
    done = subprocess.run([exe, "-dc", str(path)], capture_output=True, timeout=60, check=False)
  except (OSError, subprocess.SubprocessError):
    return []
  if done.returncode != 0:
    return []
  return done.stdout.decode("utf-8", "replace").splitlines()


def codex_exec_args(raw: str) -> list[dict]:
  """Extract the JSON argument objects of every ``tools.exec_command(...)`` call."""
  found: list[dict] = []
  for match in CODEX_EXEC_RE.finditer(raw):
    start = raw.find("{", match.end())
    if start < 0:
      continue
    depth = 0
    in_string = False
    escaped = False
    for index in range(start, len(raw)):
      char = raw[index]
      if in_string:
        if escaped:
          escaped = False
        elif char == "\\":
          escaped = True
        elif char == '"':
          in_string = False
        continue
      if char == '"':
        in_string = True
      elif char == "{":
        depth += 1
      elif char == "}":
        depth -= 1
        if depth == 0:
          try:
            parsed = json.loads(raw[start:index + 1])
          except json.JSONDecodeError:
            break
          if isinstance(parsed, dict):
            found.append(parsed)
          break
  return found


def parse_claude(record: dict) -> list[dict]:
  """Map one Claude Code transcript record to normalized observations."""
  if record.get("type") != "assistant":
    return []
  message = record.get("message")
  content = message.get("content") if isinstance(message, dict) else None
  if not isinstance(content, list):
    return []
  out = []
  for block in content:
    if not isinstance(block, dict) or block.get("type") != "tool_use":
      continue
    name = block.get("name") or ""
    args = block.get("input") if isinstance(block.get("input"), dict) else {}
    call = block.get("id", "")
    if name == "Bash" and args.get("command"):
      out.append({"kind": "cmd", "text": str(args["command"]), "call": call})
    elif name in CLAUDE_FILE_TOOLS:
      out.append({"kind": "file", "text": f"{name} {args.get('file_path', '?')}", "call": call})
  return out


def parse_codex(record: dict) -> list[dict]:
  """Map one Codex rollout record to normalized observations."""
  if record.get("type") != "response_item":
    return []
  payload = record.get("payload")
  if not isinstance(payload, dict) or payload.get("type") != "custom_tool_call":
    return []
  name = payload.get("name") or ""
  call = payload.get("call_id", "")
  raw = payload.get("input") or ""
  if name != "exec":
    return [{"kind": "tool", "text": name, "call": call}]
  out = [{"kind": "cmd", "text": str(args["cmd"]), "call": call}
         for args in codex_exec_args(raw) if args.get("cmd")]
  return out or [{"kind": "cmd", "text": str(raw).strip()[:200], "call": call}]


def parse_dsh(record: dict) -> list[dict]:
  """Map one DeepSeek Harness session record to normalized observations."""
  if record.get("type") != "tool/call":
    return []
  data = record.get("data")
  if not isinstance(data, dict):
    return []
  name = data.get("name") or ""
  call = data.get("callId", "")
  raw = data.get("arguments")
  args = raw if isinstance(raw, dict) else {}
  if isinstance(raw, str) and raw:
    try:
      args = json.loads(raw)
    except json.JSONDecodeError:
      args = {}
    if not isinstance(args, dict):
      args = {}
  if name in DSH_CMD_TOOLS:
    return [{"kind": "cmd", "text": str(args.get("command", "")), "call": call}]
  if name in DSH_FILE_TOOLS:
    return [{"kind": "file", "text": f"{name} {args.get('file_path') or args.get('path', '?')}", "call": call}]
  return []


PARSERS = {"claude-code": parse_claude, "codex": parse_codex, "dsh": parse_dsh}


def codex_cwd(path: Path) -> str:
  """Return the working directory recorded in a Codex rollout's session_meta."""
  try:
    with path.open(encoding="utf-8", errors="replace") as handle:
      for _ in range(5):
        line = handle.readline()
        if not line:
          break
        try:
          record = json.loads(line)
        except json.JSONDecodeError:
          continue
        if isinstance(record, dict) and record.get("type") == "session_meta":
          payload = record.get("payload")
          if isinstance(payload, dict):
            return str(payload.get("cwd") or "")
  except OSError:
    pass
  return ""


@functools.lru_cache(maxsize=8192)
def transcript_cwd(agent: str, path_text: str) -> str:
  """Return the working directory a session ran in, read from its own records."""
  path = Path(path_text)
  if agent == "codex":
    return codex_cwd(path)
  try:
    if path.suffix == ".zstd":
      lines = read_zstd_lines(path)[:8]
    else:
      with path.open(encoding="utf-8", errors="replace") as handle:
        lines = [handle.readline() for _ in range(8)]
  except OSError:
    return ""
  for line in lines:
    if not line:
      break
    try:
      record = json.loads(line)
    except json.JSONDecodeError:
      continue
    if not isinstance(record, dict):
      continue
    candidate = record.get("cwd")
    if isinstance(candidate, str) and candidate:
      return candidate
    data = record.get("data")
    if isinstance(data, dict) and isinstance(data.get("cwd"), str):
      return str(data["cwd"])
  return ""


def session_in_scope(agent: str, path: Path, root: Path, slug: str) -> bool:
  """Decide whether a transcript plausibly belongs to this store's project.

  Path slugs alone are not enough. Claude Code and DSH *do* encode the cwd in
  their directory names, but Codex partitions by date, and — the case that
  actually matters here — a session started in ``/home/vic`` writes to a
  different Claude directory than one started in ``the project``.
  Matching on the slug therefore hid every session launched from a parent
  directory, which on this machine is all of them.

  A session is in scope when its recorded cwd and the store root are on the same
  path in either direction: the session may have run inside the project, or in a
  parent directory that contains it.
  """
  if slug in str(path):
    return True
  cwd = transcript_cwd(agent, str(path)).rstrip("/")
  if not cwd:
    return False
  cwd = str(Path(cwd).resolve()).rstrip("/")
  base = str(root.resolve()).rstrip("/")
  return cwd == base or cwd.startswith(base + os.sep) or base.startswith(cwd + os.sep)


def scope_slug(root: Path) -> str:
  """Return the transcript-directory slug form of the store root."""
  return str(root).strip("/").replace("/", "-")


def load_watch_state(am: Path) -> dict:
  """Read the incremental scan cursor file."""
  state = load_json(am / ".watch.json", {})
  return state if isinstance(state, dict) else {}


def tail_path(am: Path, agent: str) -> Path:
  """Return the observation tail file for one agent."""
  return am / "tail" / f"{agent}.jsonl"


def append_tail(am: Path, agent: str, records: list[dict]) -> int:
  """Append normalized observations, rotating the file when it grows too long."""
  if not records:
    return 0
  path = tail_path(am, agent)
  path.parent.mkdir(parents=True, exist_ok=True)
  existing: list[str] = []
  if path.is_file():
    with path.open(encoding="utf-8") as handle:
      existing = handle.read().splitlines()
  kept = [line for line in existing if line.strip()][-TAIL_KEEP:] if len(existing) > TAIL_ROTATE_AT else existing
  lines = kept + [json.dumps(item, ensure_ascii=False, sort_keys=True) for item in records]
  if len(lines) > TAIL_KEEP:
    lines = lines[-TAIL_KEEP:]
  tmp = path.with_suffix(".tmp")
  tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
  os.replace(tmp, path)
  return len(records)


def watch_scan(am: Path, days: float = 3.0, max_sessions: int = 24, all_scopes: bool = False) -> int:
  """Ingest new transcript activity into the per-agent tail files.

  Runs implicitly before ``brief``/``status``/``handoff`` so a successor always
  sees what the dead agent was doing, without anyone having to keep a daemon
  alive. Bounded by modification time and session count to stay fast.
  """
  state = load_watch_state(am)
  files = state.get("files") if isinstance(state.get("files"), dict) else {}
  cutoff = now().timestamp() - days * 86400.0
  root = am.parent
  slug = scope_slug(root)
  total = 0

  for agent, base, pattern in transcript_sources():
    if not base.is_dir():
      continue
    candidates: list[tuple[float, Path]] = []
    for path in base.glob(pattern):
      if not all_scopes and not session_in_scope(agent, path, am.parent, slug):
        continue
      try:
        mtime = path.stat().st_mtime
      except OSError:
        continue
      if mtime < cutoff:
        continue
      candidates.append((mtime, path))
    candidates.sort(reverse=True)

    for mtime, path in candidates[:max_sessions]:
      key = str(path)
      cursor = files.get(key) if isinstance(files.get(key), dict) else {}
      if path.suffix == ".zstd":
        since = int(cursor.get("last_seq") or 0)
        records, cursor = _scan_zstd(path, agent, since)
      else:
        offset = int(cursor.get("offset") or 0)
        records, offset = _scan_plain(path, agent, offset)
        cursor = {"offset": offset}
      cursor["mtime"] = mtime
      files[key] = cursor
      total += append_tail(am, agent, records)

  state["files"] = files
  state["last_scan"] = iso(now())
  save_json(am / ".watch.json", state)
  return total


def _scan_plain(path: Path, agent: str, offset: int) -> tuple[list[dict], int]:
  """Tail a plain JSONL transcript file."""
  if offset == 0:
    # Bootstrap from recent activity rather than replaying a huge transcript.
    try:
      size = path.stat().st_size
      if size > 2_000_000:
        with path.open("rb") as handle:
          handle.seek(size - 2_000_000)
          if not handle.readline().endswith(b"\n"):
            return [], offset
          offset = handle.tell()
    except OSError:
      return [], offset
  lines, offset = read_tail_lines(path, offset)
  parser = PARSERS[agent]
  session = path.stem
  cwd = ""
  out = []
  for line in lines:
    try:
      record = json.loads(line)
    except json.JSONDecodeError:
      continue
    if not isinstance(record, dict):
      continue
    if not cwd:
      candidate = record.get("cwd") or (record.get("payload") or {}).get("cwd")
      if isinstance(candidate, str):
        cwd = candidate
    for item in parser(record):
      item.setdefault("kind", "cmd")
      item.update({"agent": agent, "session": session, "cwd": cwd, "ts": normalize_time(record.get("timestamp"))})
      if item.get("text"):
        out.append(item)
  return out, offset


def _scan_zstd(path: Path, agent: str, since_seq: int) -> tuple[list[dict], dict]:
  """Re-read a zstd-compressed log and keep records newer than ``since_seq``."""
  parser = PARSERS[agent]
  session = path.parent.name if path.parent.name else path.stem
  cwd = ""
  highest = since_seq
  out = []
  for line in read_zstd_lines(path):
    try:
      record = json.loads(line)
    except json.JSONDecodeError:
      continue
    if not isinstance(record, dict):
      continue
    seq = record.get("seq")
    if isinstance(seq, int):
      highest = max(highest, seq)
      if seq <= since_seq:
        continue
    if not cwd and isinstance(record.get("data"), dict) and record["data"].get("cwd"):
      cwd = str(record["data"]["cwd"])
    for item in parser(record):
      item.setdefault("kind", "cmd")
      item.update({"agent": agent, "session": session, "cwd": cwd, "ts": normalize_time(record.get("time"))})
      if item.get("text"):
        out.append(item)
  return out, {"last_seq": highest}


def load_tail(am: Path, limit: int = 8) -> list[dict]:
  """Return the newest observations across all agents."""
  items: list[dict] = []
  directory = am / "tail"
  if not directory.is_dir():
    return []
  for path in sorted(directory.glob("*.jsonl")):
    with path.open(encoding="utf-8") as handle:
      for line in handle:
        line = line.strip()
        if not line:
          continue
        try:
          items.append(json.loads(line))
        except json.JSONDecodeError:
          continue
  items.sort(key=lambda item: item.get("ts", ""))
  return items[-limit:]


def collapse_observations(items: list[dict]) -> list[tuple[dict, int]]:
  """Fold consecutive repeats so the six available slots show six distinct actions."""
  folded: list[list] = []
  for item in items:
    key = (item.get("agent"), item.get("kind"), str(item.get("text", "")).strip()[:80])
    if folded and folded[-1][0] == key:
      folded[-1][1] += 1
      folded[-1][2] = item
    else:
      folded.append([key, 1, item])
  return [(entry[2], entry[1]) for entry in folded]


# -------------------------------------------------------------------- hidden
#
# Some sessions carry nothing: they opened, wrote a prompt, died, and left no
# title, no intent, no progress and no command behind. They clutter every list
# forever. `am` does not own the transcripts, so it cannot delete them — but it
# can stop showing them, which is the part that was actually annoying.


def hidden_state(am: Path) -> dict:
  """Return the ``{short_id: {at, why}}`` map of suppressed sessions."""
  data = load_json(am / "hidden.json", {})
  if not isinstance(data, dict):
    return {}
  hidden = data.get("hidden")
  return hidden if isinstance(hidden, dict) else {}


def hide_session(am: Path, short: str, why: str, state: bool = True) -> int:
  """Add or remove one session from the suppressed set."""
  data = hidden_state(am)
  key = short.strip()
  if not key:
    die(T("e.bad_session"))
  if state:
    data[key] = {"at": iso(now()), "why": why}
  else:
    data.pop(key, None)
  save_json(am / "hidden.json", {"hidden": data})
  DASHBOARD_CACHE["at"] = 0.0
  return len(data)


def cmd_hide(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Suppress or restore sessions in every listing."""
  for short in args.session:
    total = hide_session(am, short, args.reason or "manual", state=not args.undo)
    print(T("c.hidden" if not args.undo else "c.unhidden", id=short, n=total))
  return 0


# ------------------------------------------------------------------- sessions
#
# The task table only knows about work somebody registered. The session view is
# the opposite: it lists whatever the agents are actually doing, derived from
# their transcripts, so `am brief` can answer "what were claude and codex up to"
# without anyone having declared a thing.
#
# The one reliable summary is the session's *first user message* — that is the
# request that created the session, written in the user's own words. Cheaper and
# more faithful than any model-generated paraphrase.


INJECTED_MARKERS = (
  "# AGENTS.md instructions", "# CLAUDE.md", "This session is being continued",
  "Skills instructions", "<environment_context>", "You are an AI assistant",
  "Time sampled while preparing", "Browser time zone for this request",
  "Current runtime context", "Current working directory:",
)


def _looks_injected(text: str) -> bool:
  """True for scaffolding the harness injects, which is not a user request."""
  if len(text) > 400 or text.startswith("#"):
    return True
  if "/tmp/claude-" in text or "output completed" in text:
    return True
  head = text[:240]
  return any(marker in head for marker in INJECTED_MARKERS)


def _strip_tags(text: str) -> str:
  """Drop injected XML-ish blocks such as ``<ide_opened_file>`` from a prompt."""
  return re.sub(r"<[^>]{0,120}>", " ", text).strip()


def session_prompt(agent: str, path: Path) -> str:
  """Return the first real user request recorded in a session transcript."""
  try:
    if path.suffix == ".zstd":
      lines = read_zstd_lines(path)[:1500]
    else:
      with path.open(encoding="utf-8", errors="replace") as handle:
        lines = [handle.readline() for _ in range(1500)]
  except OSError:
    return ""
  for line in lines:
    if not line:
      break
    try:
      record = json.loads(line)
    except json.JSONDecodeError:
      continue
    if not isinstance(record, dict):
      continue
    text = ""
    if agent == "claude-code":
      if record.get("type") != "user":
        continue
      # Tool results come back as `type: user` too. A real prompt carries
      # userType "external" and no toolUseResult payload.
      if record.get("toolUseResult") is not None or record.get("isMeta"):
        continue
      if record.get("userType") not in (None, "external"):
        continue
      # Background-task completions and other harness chatter are injected as
      # `type: user` strings, but they carry origin/turnOrigin markers.
      if record.get("origin") or record.get("turnOrigin"):
        continue
      message = record.get("message")
      content = message.get("content") if isinstance(message, dict) else None
      if isinstance(content, str):
        text = content
    elif agent == "codex":
      payload = record.get("payload") if isinstance(record.get("payload"), dict) else {}
      if payload.get("type") != "message" or payload.get("role") != "user":
        continue
      text = " ".join(str(item.get("text", "")) for item in payload.get("content") or []
                      if isinstance(item, dict))
    elif agent == "dsh":
      if record.get("type") != "user/message":
        continue
      data = record.get("data") if isinstance(record.get("data"), dict) else {}
      text = " ".join(str(item.get("text", "")) for item in data.get("content") or []
                      if isinstance(item, dict))
    text = " ".join(_strip_tags(text).split())
    if len(text) >= 12 and not _looks_injected(text):
      return text
  return ""


NOISE_MARKERS = ("You've hit your", "API Error", "rate limit", "context low")


def read_recent_lines(path: Path, max_bytes: int = 2_000_000) -> list[str]:
  """Read the tail of a transcript without loading a multi-megabyte file whole."""
  if path.suffix == ".zstd":
    return read_zstd_lines(path)[-400:]
  try:
    size = path.stat().st_size
    with path.open("rb") as handle:
      if size > max_bytes:
        handle.seek(size - max_bytes)
        handle.readline()          # drop the partial first line
      blob = handle.read()
  except OSError:
    return []
  return blob.decode("utf-8", "replace").splitlines()


def iter_lines_reversed(path: Path, block: int = 262_144):
  """Yield lines from the end of a file, newest first, without loading it whole.

  A fixed tail window is the wrong shape for this job: a 149 MB session keeps its
  last real narration megabytes away from EOF (quota errors and request blobs sit
  in between), so any fixed window either misses it or reads far more than
  needed. Walking backwards stops at the first line that matters.
  """
  try:
    with path.open("rb") as handle:
      handle.seek(0, os.SEEK_END)
      position = handle.tell()
      carry = b""
      while position > 0:
        step = min(block, position)
        position -= step
        handle.seek(position)
        chunk = handle.read(step) + carry
        pieces = chunk.split(b"\n")
        carry = pieces[0]
        for line in reversed(pieces[1:]):
          if line.strip():
            yield line
      if carry.strip():
        yield carry
  except OSError:
    return


def record_role_text(agent: str, record: dict) -> tuple[str, str]:
  """Return ``(role, text)`` for a transcript record, or ``("", "")``."""
  if agent == "claude-code":
    kind = record.get("type")
    message = record.get("message")
    if not isinstance(message, dict):
      return "", ""
    if kind == "assistant":
      parts = [b.get("text", "") for b in message.get("content") or []
               if isinstance(b, dict) and b.get("type") == "text"]
      return "assistant", " ".join(parts)
    if kind == "user" and isinstance(message.get("content"), str):
      if record.get("toolUseResult") is not None or record.get("origin") or record.get("turnOrigin"):
        return "", ""
      return "user", str(message["content"])
    return "", ""
  if agent == "codex":
    payload = record.get("payload") if isinstance(record.get("payload"), dict) else {}
    if record.get("type") != "response_item" or payload.get("type") != "message":
      return "", ""
    role = str(payload.get("role") or "")
    text = " ".join(str(i.get("text", "")) for i in payload.get("content") or [] if isinstance(i, dict))
    return (role, text) if role in ("user", "assistant") else ("", "")
  if agent == "dsh":
    if record.get("type") == "assistant/message":
      message = (record.get("data") or {}).get("message") or {}
      return "assistant", " ".join(str(b.get("text", "")) for b in message.get("content") or []
                                   if isinstance(b, dict) and b.get("type") == "text")
    if record.get("type") == "user/message":
      data = record.get("data") or {}
      return "user", " ".join(str(b.get("text", "")) for b in data.get("content") or []
                              if isinstance(b, dict))
  return "", ""


def clip_middle(text: str, width: int) -> str:
  """Keep both ends of a long message.

  Agents put the current state at the end of a status report ("currently being
  reviewed: X") and the framing at the start ("round 3 is still running"). A
  head-only truncation throws away the half that answers the question.
  """
  flat = " ".join(text.split())
  if len(flat) <= width:
    return flat
  head = int(width * 0.55)
  tail = width - head - 3
  return flat[:head].rstrip() + " … " + flat[-tail:].lstrip()


def plain(text: str) -> str:
  """Strip the light markdown that makes a one-line summary unreadable."""
  text = re.sub(r"```.*?```", " ", text, flags=re.S)
  text = re.sub(r"^\s*#+\s*", "", text, flags=re.M)
  text = re.sub(r"\s#{1,6}\s+", " ", text)
  text = text.replace("**", "").replace("`", "")
  # The text arriving here is already one line, so a line-anchored pattern for
  # table separators cannot match: strip any |---| run wherever it sits.
  text = re.sub(r"[|\s]*[-:]{3,}[|\s]*", " ", text)
  text = re.sub(r"\s*\|\s*", " ", text)
  text = re.sub(r"^\s*[-*]\s*", "", text, flags=re.M)
  return " ".join(text.split())


FAIL_WORDS = ("differ", "mismatch", "not exact", "regress", "fail", "violat")


def failure_excerpt(text: str, width: int = 260) -> str:
  """Return the part of a verifier report that states *why* it rejected.

  A verifier's `checks` field opens with provenance ("I built from git archives,
  the canonical HEADs were...") and only later says what actually broke. Showing
  the head of the field tells a successor nothing useful; anchoring on the first
  failure word does.
  """
  flat = plain(text)
  low = flat.lower()
  hits = [low.find(word) for word in FAIL_WORDS if low.find(word) >= 0]
  if not hits:
    return clip(flat, width)
  position = min(hits)
  # Start at the sentence that contains the failure, not a fixed distance back,
  # so the excerpt does not begin mid-clause.
  boundary = flat.rfind(". ", max(0, position - 160), position)
  start = boundary + 2 if boundary >= 0 else max(0, position - 40)
  return clip(flat[start:], width)


def phase_criteria(script_path: Path, phase: str, width: int = 700) -> str:
  """Pull the prompt a workflow gives the agent for one phase.

  The script calls ``agent(`...prompt...`, { label: X, phase: '<Name>', schema } )``,
  so the criteria for "what does done look like" are in that template literal.
  Interpolations are stripped, because they reference in-script state that means
  nothing outside the run.
  """
  try:
    text = script_path.read_text(encoding="utf-8", errors="replace")
  except OSError:
    return ""
  for match in re.finditer(rf"phase: '{re.escape(phase)}'", text):
    head = text[:match.start()]
    end = head.rfind("`")
    if end < 0:
      continue
    start = head.rfind("`", 0, end)
    if start < 0:
      continue
    body = head[start + 1:end]
    body = re.sub(r"\$\{[^}]*\}", " ", body)
    body = re.sub(r"\s+", " ", body).strip()
    # Interpolations leave their bare labels behind ("ACCEPTED AREAS: NOT
    # ACCEPTED:"). What matters is the instruction, which starts at TASK:.
    marker = body.find("TASK:")
    if marker >= 0:
      body = body[marker + 5:].strip()
    if len(body) >= 40:
      return clip(body, width)
  return ""


def workflow_digest(session_path: Path) -> dict:
  """Summarise the Claude Code Workflow run that belongs to a session.

  A workflow-driven session's transcript only records that the orchestrator was
  watching agents. The authoritative record — phases reached, per-area verdicts,
  and *why* it stopped — lives in ``<session>/workflows/wf_<run>.json``. Reading
  it turns "round 3 is still running" into "4 accepted, 1 rejected, 1 never ran
  because the weekly limit killed it".
  """
  if session_path.suffix == ".zstd":
    return {}
  base = session_path.parent / session_path.stem
  runs_dir = base / "workflows"
  if not runs_dir.is_dir():
    return {}
  try:
    runs = sorted(runs_dir.glob("wf_*.json"), key=lambda item: item.stat().st_mtime, reverse=True)
  except OSError:
    return {}
  if not runs:
    return {}
  data = load_json(runs[0], {})
  if not isinstance(data, dict):
    return {}

  phases = [str(phase.get("title", "")) for phase in data.get("phases") or []
            if isinstance(phase, dict)]
  reached = 0
  for entry in data.get("workflowProgress") or []:
    if isinstance(entry, dict) and entry.get("type") == "workflow_agent":
      reached = max(reached, int(entry.get("phaseIndex") or 0))

  accepted: list[str] = []
  rejected: list[str] = []
  missing: list[str] = []
  killed: list[tuple[str, str]] = []
  for raw in data.get("logs") or []:
    line = str(raw)
    verdict = re.match(r"^(\S+): (ACCEPT|REJECT)$", line)
    if verdict:
      (accepted if verdict.group(2) == "ACCEPT" else rejected).append(verdict.group(1))
      continue
    verdict = re.match(r"^(\S+): no verdict$", line)
    if verdict:
      missing.append(verdict.group(1))
      continue
    died = re.match(r"^\[impl:(\S+)\] failed: (.*)$", line)
    if died:
      killed.append((died.group(1), died.group(2)))

  # Per-area resume pointers: the journal result carries the worktree paths,
  # branches and commits produced by each implementation agent. Without them a
  # successor knows *what* is next but not *where the work physically is*.
  resume: list[dict] = []
  rejects: dict[str, str] = {}
  journal = runs[0].parent.parent / "subagents" / "workflows" / runs[0].stem / "journal.jsonl"
  labels: dict[str, str] = {}
  try:
    with journal.open(encoding="utf-8") as handle:
      for line in handle:
        if not line.strip():
          continue
        try:
          entry = json.loads(line)
        except json.JSONDecodeError:
          continue
        if entry.get("type") == "started" and entry.get("label"):
          labels[str(entry.get("key"))] = str(entry["label"]).split(":", 1)[-1]
        result = entry.get("result")
        if not isinstance(result, dict):
          continue
        if result.get("verdict") == "REJECT" and result.get("checks"):
          area = labels.get(str(entry.get("key")), "")
          if area:
            rejects[area] = failure_excerpt(str(result["checks"]))
        if "worktrees" not in result:
          continue
        area = labels.get(str(entry.get("key")), "")
        if not area:
          continue
        trees = []
        for text in result.get("worktrees") or []:
          text = str(text)
          path = text.split(" (")[0]
          branch = re.search(r"branch ([^,)]+)", text)
          # Only an explicit HEAD is trustworthy. `base ...` names the commit the
          # area branched FROM, so treating it as the tip points a successor at
          # the wrong tree entirely.
          head = re.search(r"HEAD ([0-9a-f]{7,})", text)
          trees.append({"path": path,
                        "branch": branch.group(1).strip() if branch else "",
                        "head": head.group(1) if head else ""})
        resume.append({"area": area, "trees": trees,
                       "commits": [str(c).split(" ", 1)[0] for c in result.get("commits") or []]})
  except OSError:
    pass

  next_criteria = ""
  if 0 < reached < len(phases):
    scripts = sorted((base / "workflows" / "scripts").glob(f"*{runs[0].stem}.js"))
    if scripts:
      next_criteria = phase_criteria(scripts[0], phases[reached])

  try:
    idle_min = int((now().timestamp() - runs[0].stat().st_mtime) // 60)
  except OSError:
    idle_min = 0

  return {
    "name": str(data.get("workflowName") or runs[0].stem),
    "status": str(data.get("status") or "unknown"),
    "error": str(data.get("error") or ""),
    "phases": phases,
    "reached": reached,
    "accepted": accepted,
    "rejected": rejected,
    "missing": missing,
    "killed": killed,
    "idle_min": idle_min,
    "tokens": int(data.get("totalTokens") or 0),
    "resume": resume,
    "rejects": rejects,
    "next_criteria": next_criteria,
    "next_phase": phases[reached] if 0 < reached < len(phases) else "",
  }


def session_digest(agent: str, path: Path, scan_lines: int = 300_000) -> dict:
  """Summarise a session as intent -> progress, straight from its own words.

  Three facts, each taken from the *end* of the transcript by walking backwards:

  * ``title``    — the session name the agent generated (Claude Code, DSH)
  * ``progress`` — the last assistant message long enough to be a statement of
                   state; this is where an agent says what it just finished
  * ``asked``    — the most recent real user request, which overrides the opening
                   one when the work was redirected

  ``intent`` comes from a short forward scan: the first user message. Together
  they answer "why did this start" and "where is it now", which is what a person
  needs in order to pick one. All verbatim — no model call.
  """
  intent = session_prompt(agent, path)
  progress = ""
  asked = ""
  title = ""
  action = ""
  parser = PARSERS.get(agent)
  seen = 0
  # A compressed session log has no byte-addressable line order, so it has to be
  # decompressed and walked in memory; plain JSONL is walked backwards instead.
  if path.suffix == ".zstd":
    source = (line.encode("utf-8") for line in reversed(read_zstd_lines(path)))
  else:
    source = (line.encode("utf-8") for line in reversed(read_recent_lines(path)))
  for raw in source:
    seen += 1
    if seen > scan_lines:
      break
    try:
      record = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError):
      continue
    if not isinstance(record, dict):
      continue
    kind = record.get("type")
    if not title and kind == "custom-title":
      title = str(record.get("customTitle") or "").strip()
    elif not title and kind == "session/title":
      data = record.get("data") if isinstance(record.get("data"), dict) else {}
      title = str(data.get("title") or "").strip()
    elif not asked and kind == "last-prompt":
      asked = str(record.get("lastPrompt") or "").strip()
    if parser is not None and not action:
      for item in parser(record):
        if item.get("kind") == "cmd" and item.get("text"):
          action = str(item["text"])
    role, text = record_role_text(agent, record)
    text = " ".join(_strip_tags(text).split()) if text else ""
    if role == "user" and not asked and len(text) >= 8 and not _looks_injected(text):
      asked = text
    if role == "assistant" and not progress and len(text) >= 60:
      if not any(marker in text[:80] for marker in NOISE_MARKERS):
        progress = text
    if progress and asked and title and action:
      break
  return {
    "intent": plain(intent),
    "progress": plain(progress),
    "asked": plain(asked) if asked != intent else "",
    "title": title,
    "action": plain(action),
  }


def short_session(agent: str, stem: str) -> str:
  """Return a short, unambiguous handle for a session id.

  DSH prefixes its ids with ``session-`` and Codex with a full timestamp, so a
  naive first-eight-characters handle collapses every session to ``session-`` or
  ``rollout-``. Take the identifying part instead.
  """
  if stem.startswith("session-"):
    stem = stem[len("session-"):]
  if stem.startswith("rollout-"):
    stem = stem.rsplit("-", 1)[-1]
  return re.sub(r"[^A-Za-z0-9]", "", stem)[:8] or stem[:8]


DIGEST_CACHE: dict[tuple[str, float], dict] = {}


def cached_digest(agent: str, path: Path, mtime: float) -> dict:
  """Return the digest for a session, recomputing only when its file changed.

  Scanning a session means walking its transcript, and one of them can be 150 MB.
  Without this, every dashboard poll would re-derive every session and the
  request would time out before the page ever rendered.
  """
  key = (str(path), mtime)
  hit = DIGEST_CACHE.get(key)
  if hit is not None:
    return hit
  digest = session_digest(agent, path)
  digest["workflow"] = workflow_digest(path)
  if len(DIGEST_CACHE) > 500:
    DIGEST_CACHE.clear()
  DIGEST_CACHE[key] = digest
  return digest


def recent_sessions(am: Path, days: float = 7.0, limit: int = 8,
                    include_hidden: bool = False) -> list[dict]:
  """List the newest sessions in scope, with the request that started each."""
  cutoff = now().timestamp() - days * 86400.0
  slug = scope_slug(am.parent)
  rows: list[dict] = []
  for agent, base, pattern in transcript_sources():
    if not base.is_dir():
      continue
    for path in base.glob(pattern):
      # Subagent transcripts live under `<session>/subagents/`. They are not
      # sessions a person starts, and at 1250 of them they drown the real list.
      if "subagents" in path.parts:
        continue
      if not session_in_scope(agent, path, am.parent, slug):
        continue
      try:
        mtime = path.stat().st_mtime
      except OSError:
        continue
      if mtime < cutoff:
        continue
      stem = path.parent.name if path.suffix == ".zstd" else path.stem
      rows.append({"agent": agent, "session": stem, "short": short_session(agent, stem),
                   "path": str(path), "mtime": mtime})
  rows.sort(key=lambda item: item["mtime"], reverse=True)
  if not include_hidden:
    suppressed = hidden_state(am)
    rows = [row for row in rows if row["short"] not in suppressed]
  rows = rows[:limit]
  fallback = tail_last_command(am)
  for row in rows:
    row["quiet"] = max(0, int((now().timestamp() - row["mtime"]) // 60))
    digest = cached_digest(row["agent"], Path(row["path"]), row["mtime"])
    row.update({key: digest[key] for key in ("intent", "progress", "asked", "title", "action")})
    row["workflow"] = digest.get("workflow") or {}
    row["prompt"] = row["intent"]
    observed = fallback.get(row["session"])
    if not row.get("action") and observed:
      row["action"] = plain(str(observed.get("text", "")))
    if not row["progress"]:
      source = row.get("action") or ""
      if source:
        row["progress"] = T("o.from_command", cmd=clip(source, 140))
    if not row["progress"] and row.get("title"):
      row["progress"] = row["title"]
  return rows


def tail_last_command(am: Path) -> dict[str, dict]:
  """Index the newest observed command per session, used as a summary fallback."""
  index: dict[str, dict] = {}
  directory = am / "tail"
  if not directory.is_dir():
    return index
  for path in directory.glob("*.jsonl"):
    try:
      lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
      continue
    for line in lines:
      if not line.strip():
        continue
      try:
        record = json.loads(line)
      except json.JSONDecodeError:
        continue
      session = str(record.get("session") or "")
      if not session:
        continue
      if session not in index or str(record.get("ts", "")) > str(index[session].get("ts", "")):
        index[session] = record
  return index


def format_idle(minutes: int) -> str:
  """Render an idle duration compactly, in days when it is large."""
  if minutes < 90:
    return T("o.idle_min", m=minutes)
  hours = minutes // 60
  if hours < 36:
    return T("o.idle_hour", h=hours)
  return T("o.idle_day", d=hours // 24, h=hours % 24)


def render_workflow(wf: dict) -> list[str]:
  """Render the workflow run that produced (or failed to produce) a session."""
  if not wf or not wf.get("name"):
    return []
  phases = wf.get("phases") or []
  reached = int(wf.get("reached") or 0)
  phase = phases[reached - 1] if 0 < reached <= len(phases) else T("o.none_yet")
  out = ["  - " + T("w.head", name=wf["name"], status=wf.get("status", "?"),
                    reached=reached, total=len(phases), phase=phase,
                    idle=format_idle(int(wf.get("idle_min") or 0)))]
  if wf.get("accepted"):
    out.append("  - " + T("w.accepted", list=", ".join(wf["accepted"])))
  if wf.get("rejected"):
    out.append("  - " + T("w.rejected", list=", ".join(wf["rejected"])))
  if wf.get("missing"):
    out.append("  - " + T("w.missing", list=", ".join(wf["missing"])))
  for key, why in wf.get("killed") or []:
    out.append("    - " + T("w.killed", key=key, why=clip(why, 90)))
  accepted = set(wf.get("accepted") or [])
  pointers = [item for item in wf.get("resume") or [] if item.get("area") in accepted]
  if pointers:
    out.append("  - " + T("w.resume_head"))
    for item in pointers[:6]:
      tree = (item.get("trees") or [{}])[0]
      # The worktree string only carries HEAD when the agent wrote it. Otherwise
      # the tip is the *last* commit it produced, not the first one — reporting
      # the first, or the base, would send a successor to the wrong tree.
      head = tree.get("head") or (item["commits"][-1] if item.get("commits") else "")
      branch = tree.get("branch") or f"wf6/{item['area']}"
      path = str(tree.get("path") or "")
      if "wf6/" in path:
        path = "…/" + path.split("wf6/", 1)[1]
      out.append("    - " + T("w.resume_item", area=item["area"], branch=branch,
                              head=head or "-", path=clip(path, 70)))
  for area, why in (wf.get("rejects") or {}).items():
    out.append("    - " + T("w.reject_why", area=area, why=why))
  if wf.get("next_phase"):
    out.append("  - " + T("w.next", text=T("w.next_resume", phase=wf["next_phase"])))
    if wf.get("next_criteria"):
      out.append("    " + T("w.criteria", phase=wf["next_phase"], text=wf["next_criteria"]))
  return out


def render_sessions(rows: list[dict], title_key: str = "o.sessions") -> list[str]:
  """Render one block per session: where it started, how far it got, last action."""
  out = [T(title_key), ""]
  if not rows:
    out.append(T("o.no_sessions"))
    out.append("")
    return out
  for row in rows:
    suffix = f" · {row['title']}" if row.get("title") else ""
    out.append(f"### `{row['short']}` · {row['agent']} · {T('o.quiet', m=row['quiet'])}{suffix}")
    out.append("")
    out.append("- " + T("o.started", text=clip(row.get("intent") or T("o.none_yet"), 150)))
    if row.get("asked"):
      out.append("- " + T("o.asked", text=clip(row["asked"], 120)))
    out.append("- " + T("o.progress", text=clip_middle(row.get("progress") or T("o.none_yet"), 320)))
    observed = row.get("action")
    if observed:
      out.append("- " + T("o.action", text=clip(str(observed), 120)))
    out.extend(render_workflow(row.get("workflow") or {}))
    out.append("- " + T("o.continue", id=row["short"]))
    out.append("")
  return out


def cmd_sessions(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Print the recent-session table on its own."""
  print("\n".join(render_sessions(recent_sessions(am, args.days, args.limit))))
  return 0


def cmd_adopt(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Turn a discovered session into a task and bind this session to it."""
  rows = recent_sessions(am, args.days, 60)
  key = re.sub(r"[^A-Za-z0-9]", "", args.session).lower()
  match = [row for row in rows
           if str(row.get("short", "")).lower().startswith(key) or row["session"].startswith(args.session)]
  if not match:
    die(T("e.no_session", v=args.session))
  row = match[0]
  task_id = args.id or ("s-" + str(row.get("short") or "task").lower())
  title = args.title or clip(row.get("prompt") or row["session"], 90)
  record = get_task(am, task_id, required=False)
  if record is None:
    record = {"id": task_id, "created": iso(now()), "status": "open", "owner": None,
              "title": title, "accept": args.accept or "", "spec": "",
              "session": row["session"], "session_path": row["path"], "agent": row["agent"]}
    save_task(am, record)
    append_event(am, base_event(args, "task", f"task `{task_id}`: {title}", task=task_id))
    print(T("c.adopted", id=task_id, agent=row["agent"], quiet=row["quiet"]))
  else:
    print(T("c.started_existing", id=task_id))
  return claim_record(am, cfg, args, record)


# --------------------------------------------------------------------- recall
#
# Search the transcripts themselves rather than a distilled copy of them. A
# summary is lossy and unreproducible; the transcript is neither. Plain
# substring matching also sidesteps tokenisation entirely, which matters because
# these sessions are mostly Chinese and FTS5's default tokeniser cannot split CJK.


def record_text(agent: str, record: dict) -> str:
  """Concatenate the human-readable text of one transcript record."""
  parts: list[str] = []
  if agent == "claude-code":
    message = record.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
      parts.append(content)
    elif isinstance(content, list):
      for block in content:
        if not isinstance(block, dict):
          continue
        if block.get("type") == "text":
          parts.append(str(block.get("text", "")))
        elif block.get("type") == "tool_use":
          args = block.get("input") if isinstance(block.get("input"), dict) else {}
          parts.append(str(args.get("command") or args.get("file_path") or block.get("name", "")))
  elif agent == "codex":
    payload = record.get("payload") if isinstance(record.get("payload"), dict) else {}
    if payload.get("type") == "message":
      for item in payload.get("content") or []:
        if isinstance(item, dict) and item.get("text"):
          parts.append(str(item["text"]))
    elif payload.get("type") == "custom_tool_call":
      parts.extend(str(args["cmd"]) for args in codex_exec_args(payload.get("input") or "") if args.get("cmd"))
  elif agent == "dsh":
    data = record.get("data") if isinstance(record.get("data"), dict) else {}
    message = data.get("message") if isinstance(data.get("message"), dict) else None
    blocks = (message or {}).get("content") or data.get("content")
    if isinstance(blocks, list):
      for item in blocks:
        if isinstance(item, dict) and item.get("text"):
          parts.append(str(item["text"]))
    arguments = data.get("arguments")
    try:
      args = json.loads(arguments) if isinstance(arguments, str) else arguments
    except json.JSONDecodeError:
      args = None
    if isinstance(args, dict) and args.get("command"):
      parts.append(str(args["command"]))
  return " ".join(part for part in parts if part)


def clip(text: str, width: int) -> str:
  """Flatten and truncate text for one-line display."""
  flat = " ".join(text.split())
  return flat if len(flat) <= width else flat[:width - 1] + "…"


def snippet(text: str, terms: list[str], width: int = 90) -> str:
  """Return a window of ``text`` centred on the first matching term."""
  flat = " ".join(text.split())
  low = flat.lower()
  position = min((low.find(term) for term in terms if term in low), default=0)
  start = max(0, position - width // 2)
  piece = flat[start:start + width]
  if start > 0:
    piece = "…" + piece
  if start + width < len(flat):
    piece += "…"
  return piece


def recall_scan(am: Path, terms: list[str], days: float, max_sessions: int,
                all_scopes: bool, agent_filter: str | None, limit: int) -> list[dict]:
  """Stream the transcripts and return the newest matching lines."""
  cutoff = now().timestamp() - days * 86400.0
  slug = scope_slug(am.parent)
  casefold = any(char.isascii() and char.isalpha() for term in terms for char in term)
  hits: list[dict] = []

  for agent, base, pattern in transcript_sources():
    if agent_filter and agent != agent_filter:
      continue
    if not base.is_dir():
      continue
    candidates: list[tuple[float, Path]] = []
    for path in base.glob(pattern):
      if not all_scopes and not session_in_scope(agent, path, am.parent, slug):
        continue
      try:
        mtime = path.stat().st_mtime
      except OSError:
        continue
      if mtime < cutoff:
        continue
      candidates.append((mtime, path))
    candidates.sort(reverse=True)

    for _, path in candidates[:max_sessions]:
      lines = read_zstd_lines(path) if path.suffix == ".zstd" else _read_lines(path)
      for line in lines:
        # Only pay for case-folding when a term can actually have case. Chinese
        # queries are the common case here and `.lower()` on every line of a
        # 100 MB transcript is not free.
        low = line.lower() if casefold else line
        if not all(term in low for term in terms):
          continue
        try:
          record = json.loads(line)
        except json.JSONDecodeError:
          continue
        if not isinstance(record, dict):
          continue
        text = record_text(agent, record)
        if not text or not all(term in text.lower() for term in terms):
          continue
        hits.append({
          "ts": normalize_time(record.get("timestamp") or record.get("time")),
          "agent": agent,
          "session": path.parent.name if path.suffix == ".zstd" else path.stem,
          "text": snippet(text, terms),
          "path": str(path),
        })
        if len(hits) >= 4000:
          break

  hits.sort(key=lambda item: item["ts"], reverse=True)
  return hits[:limit]


def _read_lines(path: Path) -> list[str]:
  """Read a text file as lines, tolerating undecodable bytes."""
  try:
    return path.read_text(encoding="utf-8", errors="replace").splitlines()
  except OSError:
    return []


def cmd_recall(am: Path, cfg: dict, args: argparse.Namespace) -> int:
  """Search every transcript, exactly or semantically.

  With ``--smart`` the literal pass prints first and the semantic pass follows.
  Loading the encoder costs several seconds in a cold process, and making the
  caller wait for it when exact matches are already in hand is a worse trade
  than losing a globally-ranked merge.
  """
  terms = [term.lower() for term in args.query.split() if term.strip()]
  if not terms:
    die(T("e.no_term"))

  literal = recall_scan(am, terms, args.days, args.max_sessions, args.all, args.agent_filter, args.limit)
  for item in literal:
    print(f"`{str(item['ts'])[:16].replace('T', ' ')}` {T('rc.literal')} {item['agent']} "
          f"{str(item.get('session', ''))[:18]}: {item.get('text', '')}")
  if not literal:
    print(T("rc.no_literal", q=" ".join(terms), d=f"{args.days:g}"))
  sys.stdout.flush()

  semantic: list[dict] = []
  weak = False
  if args.smart:
    print(T("rc.searching"), file=sys.stderr, flush=True)
    # Over-fetch, then apply the agent / recency filters the literal pass already
    # honours. The vector index has no such filter of its own, so without this
    # `--agent codex --smart` would happily return Claude hits.
    rows = semantic_query(am, args.query, max(args.limit * 4, 24))
    cutoff = (now() - timedelta(days=args.days)).isoformat()
    eligible = [row for row in rows
                if (not args.agent_filter or row.get("agent") == args.agent_filter)
                and str(row.get("ts", "")) >= cutoff]
    semantic = [row for row in eligible if float(row.get("score", 0.0)) >= args.min_score][:args.limit]
    if not semantic and eligible:
      # A fixed cosine floor is a blunt instrument: bge-small-zh puts genuinely
      # related Chinese prose anywhere from 0.45 up, and an unusual phrasing can
      # sit below the floor while still being the best thing in the corpus.
      # Returning the closest few, labelled, beats returning nothing.
      semantic = eligible[:3]
      weak = True
      print(T("rc.weak_note", s=f"{args.min_score:g}"),
            file=sys.stderr)
    covered = float(load_json(index_dir(am) / "meta.json", {}).get("window_days") or 0)
    if covered and args.days > covered:
      print(T("rc.index_window", c=f"{covered:g}", d=f"{args.days:g}"),
            file=sys.stderr)

    seen = {(item.get("path", ""), str(item.get("text", ""))[:80]) for item in literal}
    fresh = [row for row in semantic
             if (row.get("path", ""), str(row.get("text", ""))[:80]) not in seen]
    if fresh and literal:
      print(T("rc.semantic"))
    for row in fresh:
      mark = T("rc.weak") if weak else ""
      print(f"`{str(row['ts'])[:16].replace('T', ' ')}` [{mark}{float(row.get('score', 0)):.3f}] "
            f"{row['agent']} {str(row.get('session', ''))[:18]}: {clip(str(row.get('text', '')), 170)}")

  sys.stdout.flush()
  if args.smart:
    print("\n" + T("rc.summary", l=len(literal), s=len(semantic), d=f"{args.days:g}"), file=sys.stderr)
  else:
    print("\n" + T("rc.summary_off", l=len(literal), d=f"{args.days:g}"), file=sys.stderr)
  return 0


# ------------------------------------------------------------------- dashboard
#
# A browser view over the same store. Standard library only: ThreadingHTTPServer
# serves one page and one JSON endpoint, and the page re-fetches every couple of
# seconds. Nothing is pushed to disk, so the dashboard can never become a second
# source of truth.

DASHBOARD_CACHE: dict[str, object] = {"at": 0.0, "payload": None, "scanned": 0.0}


def state_payload(am: Path, cfg: dict, ttl: float = 15.0) -> dict:
  """Snapshot everything the dashboard shows, cached briefly."""
  stamp = time.time()
  if DASHBOARD_CACHE["payload"] is not None and stamp - float(DASHBOARD_CACHE["at"]) < ttl:
    return DASHBOARD_CACHE["payload"]  # type: ignore[return-value]

  if stamp - float(DASHBOARD_CACHE["scanned"]) > 60:
    try:
      watch_scan(am)
    except Exception:
      pass
    DASHBOARD_CACHE["scanned"] = stamp

  tasks = []
  for item in load_tasks(am):
    lease = read_lease(am, item["id"]) or {}
    tasks.append({
      "id": item.get("id"),
      "title": item.get("title") or "",
      "status": item.get("status"),
      "owner": item.get("owner") or lease.get("agent") or "",
      "session": str(lease.get("session") or ""),
      "lease_min": lease.get("remaining_min"),
      "quiet": lease.get("last_seen_min"),
      "idle": bool(lease.get("idle")),
      "next": item.get("next") or "",
      "accept": item.get("accept") or "",
      "evidence": item.get("evidence") or "",
    })

  suppressed = hidden_state(am)
  # Show every session inside the window. A fixed cap made hiding one session
  # pull the next-oldest into view, which read as a bug because it was one.
  window_days = float(cfg.get("dashboard_days") or 30)
  scanned = recent_sessions(am, window_days, 400, include_hidden=True)
  sessions = []
  for row in [r for r in scanned if r["short"] not in suppressed]:
    wf = row.get("workflow") or {}
    sessions.append({
      "short": row["short"], "agent": row["agent"], "quiet": row["quiet"],
      "title": row.get("title") or "", "intent": row.get("intent") or "",
      "asked": row.get("asked") or "", "progress": row.get("progress") or "",
      "action": row.get("action") or "",
      "workflow": {k: wf.get(k) for k in
                   ("name", "status", "error", "phases", "reached", "accepted",
                    "rejected", "missing", "killed", "idle_min", "rejects",
                    "next_phase", "next_criteria", "resume") if wf.get(k) is not None},
    })

  hidden_rows = []
  for row in [r for r in scanned if r["short"] in suppressed]:
    hidden_rows.append({"short": row["short"], "agent": row["agent"], "quiet": row["quiet"],
                        "title": row.get("title") or "", "why": (suppressed[row["short"]] or {}).get("why", "")})

  active = [row for row in sessions if row["quiet"] <= 5]
  holders = {task["owner"] for task in tasks if task["status"] in ("claimed", "open")}
  main = None
  for row in active:
    if row["agent"] in holders:
      main = row
      break
  if main is None and active:
    main = active[0]
  if main is not None:
    main = dict(main, is_main=True)

  payload = {
    "project": cfg.get("project"),
    "store": str(am),
    "generated": iso(now()),
    "tasks": tasks,
    "sessions": sessions,
    "active": [row["short"] for row in active],
    "hidden": hidden_rows,
    "main": main,
    "window_days": window_days,
    "counts": {
      "tasks_open": sum(1 for t in tasks if t["status"] in ("open", "claimed", "blocked")),
      "sessions": len(sessions),
      "active": len(active),
    },
  }
  DASHBOARD_CACHE["payload"] = payload
  DASHBOARD_CACHE["at"] = time.time()
  return payload


