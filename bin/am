  <button class="icon" id="pause" title="暂停自动刷新（快捷键 p）">暂停</button>
  <div class="clock" id="stamp">…</div>
</header>
<div class="shell">
  <aside class="side">
    <div class="side-top"><div class="find">
      <span style="color:var(--faint);font-size:12px">⌕</span>
      <input id="q" placeholder="搜索会话 / 标题 / 内容" autocomplete="off">
      <kbd>/</kbd>
    </div></div>
    <div class="nav" id="nav"></div>
  </aside>
  <main class="pane" id="pane"></main>
